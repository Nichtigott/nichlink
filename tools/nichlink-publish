#!/bin/sh
set -eu

# Publish the nine crates in dependency order, one level at a time.
# 按依赖顺序、一层一层地发布九个 crate。
#
# Why a script and not nine hand-typed commands: every dependent writes its
# internal requirement as caret `0.1.0` (`docs/roadmap-1.0.md` decision 1), so
# publishing `run_method` before the index serves `nichlink-core 0.1.0` fails
# resolution. The order below is that dependency chain, and the script waits for
# each level to appear in the index before starting the next one — the wait is
# the part a human forgets.
# 为什么要脚本而不是手敲九条命令：每个依赖方都把内部依赖写成 caret `0.1.0`
# （`docs/roadmap-1.0.md` 决策 1），因此在 index 提供 `nichlink-core 0.1.0` 之前发布
# `run_method` 会解析失败。下面的顺序就是那条依赖链，脚本会在开始下一层之前等待上一层出现
# 在 index 里——这个等待正是人容易忘掉的部分。
#
# Safety: the default mode is a dry run. Nothing is uploaded unless both
# `--publish` and `--yes` are given, because a published version is immutable on
# crates.io — it can only be yanked, never replaced.
# 安全：默认是 dry-run。只有同时给出 `--publish` 与 `--yes` 才会真的上传，因为 crates.io
# 上已发布的版本不可变——只能 yank，不能替换。
#
# Dry-run behaviour before the first release: a crate whose versioned
# `nichlink-*` dependency is not on the index yet is *skipped with a warning*
# instead of failing, exactly like `tools/nichlink-package-audit`. So today the
# dry run verifies `nichlink-core` in full and reports the other eight as
# waiting; after core is published it verifies the next level, and so on.
# 首次发布之前的 dry-run 行为：带版本号的 `nichlink-*` 依赖尚未出现在 index 上的 crate
# 会被**跳过并警告**，而不是失败，与 `tools/nichlink-package-audit` 一致。因此今天 dry-run
# 会完整校验 `nichlink-core`、把其余八个报成"等待中"；core 发布之后就会校验下一层，依此类推。
#
# Real publish:
#   CARGO_REGISTRY_TOKEN=... tools/nichlink-publish --publish --yes
#   tools/nichlink-publish --publish --yes --allow-dirty   # from a dirty tree
#
# The dependency table is hand-maintained, and a hand-maintained table goes
# stale silently; check it against the manifests before trusting the order:
#   tools/nichlink-publish --check-table
# 依赖表是手工维护的，而手工维护的表会静默过期；在信任这个顺序之前先拿清单核对：
#   tools/nichlink-publish --check-table
#
# Both modes above are checks: they upload nothing, and neither combines with
# `--publish` (that combination is refused rather than quietly doing nothing).
# 上面两个模式都是检查：不上传任何东西，也不与 `--publish` 组合（该组合会被直接拒绝，
# 而不是静默地什么都不做）。
#
# After it finishes, prove that a stranger can consume the release:
#   tools/nichlink-publish --verify-consumers
# That builds a throwaway crate outside this checkout and `cargo add`s all nine
# crates by version, so resolution runs against the index rather than against the
# local paths. Packaging was verified before the upload; this is the half that
# only the published crates can answer.
# 发布完成后，证明陌生人能消费这个版本：
#   tools/nichlink-publish --verify-consumers
# 它在本检出之外建一个一次性 crate，按版本 `cargo add` 九个 crate，因此解析发生在 index 上
# 而不是本地路径上。打包在上传前已经验证过；这一半只有已发布的 crate 才答得出来。
#
# The index probe below is deliberately duplicated from
# `tools/nichlink-package-audit` rather than shared: both tools must stay
# runnable on their own from any directory (CI runs the audit, a maintainer runs
# this one), and the probe is the only thing they have in common.
# 下面的 index 探针刻意与 `tools/nichlink-package-audit` 各留一份而不共用：两个工具都必须
# 能从任意目录独立运行（CI 跑审计，维护者跑本脚本），而探针是它们唯一共通的东西。

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

index_url="https://index.crates.io"
wait_seconds=${NICHLINK_PUBLISH_WAIT:-300}

# One level per line, in dependency order. Crates on the same line are
# independent of each other.
# 每行一层，按依赖顺序。同一行内的 crate 互不依赖。
levels='
nichlink-core
nichlink-macro nichlink-build-method nichlink-mcp
nichlink-run-method
nichlink-debug-method nichlink-plugin-host
nichlink-studio
nichlink-cli
'

publish=false
yes=false
allow_dirty=false
verify_consumers=false
check_table=false

for arg in "$@"; do
  case "$arg" in
    --publish) publish=true ;;
    --yes) yes=true ;;
    --allow-dirty) allow_dirty=true ;;
    --verify-consumers) verify_consumers=true ;;
    --check-table) check_table=true ;;
    -h|--help)
      # Print the leading comment block: every `#` line, skipping the blank
      # line after `set -eu`, and stopping at the first line of code.
      # 打印文件开头的注释块：所有 `#` 行，跳过 `set -eu` 后的空行，遇到第一行代码即停。
      awk 'NR <= 2 { next } /^#/ { print; next } /^[[:space:]]*$/ { next } { exit }' "$0" |
        sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "error: unknown argument '$arg' (see --help)" >&2
      exit 2
      ;;
  esac
done

if [ "$publish" = true ] && [ "$yes" != true ]; then
  echo "error: --publish also needs --yes; publishing is irreversible" >&2
  exit 2
fi

# The two check modes exit on their own, so combining either with `--publish`
# would upload nothing and still exit 0 — a maintainer could read that as a
# finished release. Refuse the combination instead.
# 两个检查模式各自独立退出，因此任何一个与 `--publish` 组合都会什么都不上传却退出 0——
# 维护者可能把它读成"发布完成"。宁可拒绝这个组合。
if [ "$check_table" = true ] && [ "$verify_consumers" = true ]; then
  echo "error: --check-table and --verify-consumers are separate modes" >&2
  exit 2
fi
if [ "$publish" = true ] && { [ "$check_table" = true ] || [ "$verify_consumers" = true ]; }; then
  echo "error: --publish does not combine with --check-table or --verify-consumers" >&2
  exit 2
fi

if [ "$publish" = true ]; then
  if [ -z "${CARGO_REGISTRY_TOKEN:-}" ]; then
    # `cargo publish` can also read the token from ~/.cargo/credentials.toml, so
    # an unset variable is a warning rather than an error.
    # `cargo publish` 也能从 ~/.cargo/credentials.toml 读 token，因此变量未设置只是警告。
    echo "note: CARGO_REGISTRY_TOKEN is unset; Cargo will use its credentials file" >&2
  fi
  if [ "$allow_dirty" != true ] && [ -n "$(git status --porcelain)" ]; then
    echo "error: the working tree has uncommitted changes; commit them first," \
      "or pass --allow-dirty if the published content is exactly what you mean" >&2
    exit 1
  fi
fi

# Sparse-index path for a crate name: 1/<n>, 2/<n>, 3/<c>/<n>, else
# <first two>/<next two>/<n>.
# crate 名的 sparse index 路径：1/<n>、2/<n>、3/<c>/<n>，其余为
# <前两个字符>/<后两个字符>/<n>。
index_path() {
  name=$1
  length=${#name}
  if [ "$length" -eq 1 ]; then
    printf '1/%s' "$name"
  elif [ "$length" -eq 2 ]; then
    printf '2/%s' "$name"
  elif [ "$length" -eq 3 ]; then
    printf '3/%s/%s' "$(printf '%s' "$name" | cut -c1)" "$name"
  else
    printf '%s/%s/%s' \
      "$(printf '%s' "$name" | cut -c1-2)" \
      "$(printf '%s' "$name" | cut -c3-4)" \
      "$name"
  fi
}

# Whether one exact version is served by the index; a network failure counts as
# "not published" so the caller waits rather than publishing into a bad order.
# 某个精确版本是否已由 index 提供；网络失败按"未发布"处理，使调用方等待，而不是按错误顺序
# 发布。
is_published() {
  name=$1
  version=$2
  path=$(index_path "$name")
  if command -v curl >/dev/null 2>&1; then
    body=$(curl -fsS --max-time 20 "$index_url/$path" 2>/dev/null) || return 1
  elif command -v wget >/dev/null 2>&1; then
    body=$(wget -q -O - --timeout=20 "$index_url/$path" 2>/dev/null) || return 1
  else
    return 1
  fi
  printf '%s\n' "$body" | grep -F "\"vers\":\"$version\"" >/dev/null 2>&1
}

workspace_version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
if [ -z "$workspace_version" ]; then
  echo "error: could not read [workspace.package] version from Cargo.toml" >&2
  exit 1
fi

# "<crate>:<space-separated versioned nichlink-* dependencies>"
# "<crate>:<以空格分隔的带版本号 nichlink-* 依赖>"
dependencies='
nichlink-core:
nichlink-macro:nichlink-core
nichlink-build-method:nichlink-core
nichlink-mcp:nichlink-core
nichlink-run-method:nichlink-core nichlink-macro
nichlink-debug-method:nichlink-run-method
nichlink-plugin-host:nichlink-run-method
nichlink-studio:nichlink-run-method nichlink-debug-method nichlink-build-method
nichlink-cli:nichlink-build-method nichlink-core nichlink-mcp nichlink-studio
'

# The internal dependencies of one crate, read from the table above.
# The internal dependencies of one crate, read from the table above as whole
# lines. Reading it word-wise would hand back an edge line's dependencies as
# entries of their own, and stopping at the first word would drop every
# dependency after the first — which is what let `nichlink-cli` look publishable
# while `nichlink-mcp` and `nichlink-studio` were still missing from the index.
# 读取上表中某个 crate 的内部依赖，按整行读取。按词读取会把一条边行的被依赖者当成独立条目，
# 而在第一个词处停下会丢掉第一个之后的每个依赖——正是这一点让 `nichlink-cli` 在
# `nichlink-mcp` 与 `nichlink-studio` 尚未进入 index 时看起来可以发布。
deps_of() {
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    case "$entry" in
      "$1":*) printf '%s' "${entry#"$1":}"; return 0 ;;
    esac
  done <<EOF
$dependencies
EOF
  return 1
}

# `cargo publish` flags that do not depend on the mode.
cargo_flags="--locked"
if [ "$allow_dirty" = true ] || [ "$publish" != true ]; then
  # A dry run verifies packaging, not provenance; a dirty tree is the normal
  # state while preparing a release.
  # dry-run 校验的是打包而不是来源；准备发布期间工作区通常就是脏的。
  cargo_flags="$cargo_flags --allow-dirty"
fi

# Every crate in the dependency table, in the table's own order, one name per
# line: reading the table as words instead of as lines would hand back an edge
# line's dependencies as if they were crates of their own.
# 依赖表里的每个 crate，按表内顺序，每行一个名字：按词而不是按行读取，会把一条边行的
# 被依赖者当成独立 crate 交出来。
all_crates=$(
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    printf '%s\n' "${entry%%:*}"
  done <<EOF
$dependencies
EOF
)
# Prove that a crate outside this checkout can resolve the release from the
# index. This is the verification a dry run cannot do: packaging reads local
# paths, and only a consumer reads the published requirements.
# 证明本检出之外的一个 crate 能从 index 解析这次发布。这是 dry-run 做不到的验证：打包读的是
# 本地路径，只有消费者读的是已发布的要求。
if [ "$verify_consumers" = true ]; then
  directory=$(mktemp -d)
  trap 'rm -rf "$directory"' EXIT INT TERM
  consumer="$directory/consumer"
  # `--vcs none`: this is a throwaway crate, and nothing here should run `git`.
  # `--vcs none`：这是一次性 crate，这里任何东西都不该去动 `git`。
  if ! cargo new --lib --quiet --vcs none "$consumer" 2>/dev/null; then
    echo "error: cannot create a throwaway crate in $directory" >&2
    exit 1
  fi
  resolved=""
  unresolved=""
  for crate in $all_crates; do
    if (cd "$consumer" && cargo add "$crate@$workspace_version" --quiet >/dev/null 2>&1); then
      resolved="$resolved $crate"
    else
      unresolved="$unresolved $crate"
    fi
  done
  if [ -n "$unresolved" ]; then
    cat >&2 <<EOF
error: the index does not serve this version for: ${unresolved# }
Nothing is wrong with the checkout: those crates are not published yet, or the
tag was published for a different version than $workspace_version. Publish first
(\`tools/nichlink-publish --publish --yes\`), then run this again.
错误：index 上还没有这些 crate 的该版本：${unresolved# }
本检出没有问题：这些 crate 尚未发布，或者标签对应的版本不是 $workspace_version。请先发布
（\`tools/nichlink-publish --publish --yes\`），再重跑本命令。
EOF
    exit 1
  fi
  if ! (cd "$consumer" && cargo check --quiet); then
    echo "error: a consumer resolved every crate but could not build them together" >&2
    exit 1
  fi
  printf 'consumer resolved and built:%s\n' "$resolved"
  exit 0
fi

# Version problems in one shipped manifest, one per line, empty when there are
# none. `--check-table` compared dependency *names* only, so a member whose
# manifest said `0.1.1` passed while the tag check and the index wait used the
# root's `0.1.0` — and `cargo publish` uploads the *member's* version. The three
# readings are: the crate's own version, a dependency spelled inline, and a
# dependency spelled as a `[dependencies.nichlink-x]` table with its version on a
# separate line.
# 一个已发布清单里的版本问题，每行一条，没有则为空。`--check-table` 过去只比依赖**名字**，
# 因此某个清单写着 `0.1.1` 的成员照样通过，而 tag 检查与 index 等待用的是根清单的 `0.1.0`——
# `cargo publish` 上传的却是**该成员**的版本。这里读三处：crate 自己的版本、行内写的依赖、
# 以及用 `[dependencies.nichlink-x]` 表写、版本在另一行的依赖。
version_problems() {
  manifest=$1
  crate=$2
  want=$3
  awk -v crate="$crate" -v want="$want" '
    /^\[/ {
      section = $0
      dotted = ""
      if (section ~ /^\[((build-)?dependencies|target\..*\.dependencies)\.nichlink-[a-z-]+\]$/) {
        dotted = section
        sub(/^\[.*dependencies\./, "", dotted)
        sub(/\]$/, "", dotted)
      }
      next
    }
    section == "[package]" && /^version\.workspace *= *true/ { next }
    section == "[package]" && /^version *= *"/ {
      value = $0
      sub(/^version *= *"/, "", value)
      sub(/".*$/, "", value)
      if (value != want) {
        printf "%s declares version %s, but the workspace version is %s; a tag for %s would publish %s\n", crate, value, want, want, value
      }
      next
    }
    dotted != "" && /^version *= *"/ {
      value = $0
      sub(/^version *= *"/, "", value)
      sub(/".*$/, "", value)
      if (value != want) {
        printf "%s asks for %s %s, but every internal requirement must be %s\n", crate, dotted, value, want
      }
      next
    }
    # `nichlink-x.workspace = true` inherits its requirement from the root table
    # `[workspace.dependencies]`, which `workspace_requirement_problems` checks once
    # instead of once per member.
    # `nichlink-x.workspace = true` 的需求继承自根的 `[workspace.dependencies]`，由
    # `workspace_requirement_problems` 检查一次，而不是每个成员各查一次。
    section ~ /^\[((build-)?dependencies|target\..*\.dependencies)\]$/ && /^nichlink-[a-z-]+\.workspace *= *true/ { next }
    section ~ /^\[((build-)?dependencies|target\..*\.dependencies)\]$/ && /^nichlink-[a-z-]+ *=/ {
      if (match($0, /version *= *"[^"]*"/)) {
        value = substr($0, RSTART, RLENGTH)
        sub(/^version *= *"/, "", value)
        sub(/"$/, "", value)
        if (value != want) {
          printf "%s asks for %s %s, but every internal requirement must be %s\n", crate, $1, value, want
        }
      }
    }
  ' "$manifest"
}

# Version problems in the root's `[workspace.dependencies]`, one per line. A
# requirement inherited with `x.workspace = true` is spelled once there, so it is
# checked once there rather than by every member that inherits it.
# 根的 `[workspace.dependencies]` 里的版本问题，每行一条。用 `x.workspace = true` 继承的需求
# 只在那里写一次，因此也只在那里检查一次，而不是由每个继承它的成员各查一遍。
workspace_requirement_problems() {
  want=$1
  awk -v want="$want" '
    /^\[/ { section = $0; next }
    section == "[workspace.dependencies]" && /^nichlink-[a-z-]+ *=/ {
      if (match($0, /version *= *"[^"]*"/)) {
        value = substr($0, RSTART, RLENGTH)
        sub(/^version *= *"/, "", value)
        sub(/"$/, "", value)
        if (value != want) {
          crate = $1
          printf "[workspace.dependencies] %s requires %s, but every internal requirement must be %s\n", crate, value, want
        }
      }
    }
  ' Cargo.toml
}

# Derive the release order's truth from the manifests and compare it with the
# table above. Nothing here needs the network: it is the check that keeps the
# table from rotting between releases.
# 从清单推导发布顺序的事实，并与上表对比。这里不需要网络：它是让表在两次发布之间不腐烂的检查。
if [ "$check_table" = true ]; then
  problems=""
  # Workspace members, one directory per line. `sed -n '/^members = \[/,/\]/p'`
  # does not do this: a sed range does not test its end address on the start
  # line, so a one-line array would make the range run on to the next line that
  # contains a `]` — in this workspace that is `[workspace.package]`, which then
  # entered the member list as a directory name. It happened not to exist, which
  # is exactly how such a bug stays invisible.
  # 工作区成员，每行一个目录。`sed -n '/^members = \[/,/\]/p'` 做不到这一点：sed 的范围在
  # 起始行上不测试结束地址，因此单行数组会让范围一直跑到下一个含 `]` 的行——在本工作区就是
  # `[workspace.package]`，它于是作为一个目录名进入了成员列表。它恰好不存在，而这正是这类
  # 缺陷得以隐形的方式。
  members=$(awk '
    /^members *= *\[/ { inside = 1 }
    inside {
      line = $0
      sub(/^[^[]*\[/, "", line)
      sub(/\].*$/, "", line)
      gsub(/[",]/, "", line)
      count = split(line, parts, / +/)
      for (i = 1; i <= count; i++) if (parts[i] != "") print parts[i]
      if ($0 ~ /\]/) exit
    }
  ' Cargo.toml)
  # Crates that ship: a member without `publish = false`.
  shipped=""
  for member in $members; do
    manifest="$member/Cargo.toml"
    [ -f "$manifest" ] || continue
    if grep -qE '^publish *= *false' "$manifest"; then
      continue
    fi
    name=$(sed -n 's/^name = "\(.*\)"/\1/p' "$manifest" | head -n 1)
    [ -n "$name" ] || continue
    shipped="$shipped $name"
    # `[dependencies]` and `[build-dependencies]` both have to resolve on the
    # index, including a target-specific section and a dotted
    # `[dependencies.nichlink-x]` table; `[dev-dependencies]` never ships, so it
    # is deliberately ignored. Any other spelling is not read here, so a crate
    # declared that way shows up as a disagreement with the table — which is the
    # direction that gets looked at.
    # `[dependencies]` 与 `[build-dependencies]` 都必须在 index 上解析，包括按目标限定的段
    # 与 `[dependencies.nichlink-x]` 这种点表；`[dev-dependencies]` 不会出厂，因此有意忽略。
    # 其他拼法这里读不到，因此那样声明的 crate 会表现为与表不一致——正是会被看见的那个方向。
    actual=$(awk '
      /^\[/ {
        section = $0
        if (section ~ /^\[((build-)?dependencies|target\..*\.dependencies)\.nichlink-[a-z-]+\]$/) {
          name = section
          sub(/^\[.*dependencies\./, "", name)
          sub(/\]$/, "", name)
          print name
        }
        next
      }
      section ~ /^\[((build-)?dependencies|target\..*\.dependencies)\]$/ && /^nichlink-[a-z-]+ *=/ { print $1 }
      # `nichlink-x.workspace = true` names the same dependency in its inherited
      # spelling; reading it through `[workspace.dependencies]` is what stops the
      # table from looking wrong and inviting its own removal.
      # `nichlink-x.workspace = true` 用继承的拼法命名同一个依赖；经
      # `[workspace.dependencies]` 读出它，才不会让表显得不对并诱使人删掉它。
      section ~ /^\[((build-)?dependencies|target\..*\.dependencies)\]$/ && /^nichlink-[a-z-]+\.workspace *= *true/ {
        name = $1
        sub(/\.workspace.*/, "", name)
        print name
      }
    ' "$manifest" | sort -u)
    version_issues=$(version_problems "$manifest" "$name" "$workspace_version")
    if [ -n "$version_issues" ]; then
      problems="$problems
$version_issues"
    fi
    tabled=$(deps_of "$name" | tr ' ' '\n' | sed '/^$/d' | sort)
    if [ "$actual" != "$tabled" ]; then
      problems="$problems
$name:
  manifest: $(printf '%s' "$actual" | tr '\n' ' ')
  table:    $(printf '%s' "$tabled" | tr '\n' ' ')"
    fi
  done
  shipped=$(printf '%s' "$shipped" | tr ' ' '\n' | sed '/^$/d' | sort)
  listed=$(printf '%s\n' "$all_crates" | sort)
  if [ "$shipped" != "$listed" ]; then
    problems="$problems
the set of published crates differs:
  manifest: $(printf '%s' "$shipped" | tr '\n' ' ')
  table:    $(printf '%s' "$listed" | tr '\n' ' ')"
  fi
  # The level table is the second hand-maintained ordering. Publishing a crate
  # before something it depends on fails resolution, so check that every crate
  # is listed exactly once and always after its dependencies.
  # 层表是第二份手工维护的顺序。在依赖之前发布某个 crate 会导致解析失败，因此检查每个
  # crate 恰好出现一次，且总在其依赖之后。
  seen=""
  for level in $levels; do
    for crate in $level; do
      for dep in $(deps_of "$crate"); do
        case " $seen " in
          *" $dep "*) ;;
          *) problems="$problems
$crate is listed before its dependency $dep" ;;
        esac
      done
      seen="$seen $crate"
    done
  done
  if [ "$(printf '%s\n' $seen | sort)" != "$listed" ]; then
    problems="$problems
the level table and the dependency table disagree about which crates ship:
  levels:       $(printf '%s\n' $seen | sort | tr '\n' ' ')
  dependencies: $(printf '%s\n' "$listed" | tr '\n' ' ')"
  fi
  workspace_issues=$(workspace_requirement_problems "$workspace_version")
  if [ -n "$workspace_issues" ]; then
    problems="$problems
$workspace_issues"
  fi
  if [ -n "$problems" ]; then
    printf 'error: the release tables in %s no longer match the manifests:%s\n' "$0" "$problems" >&2
    printf '错误：%s 里的发布表已与清单不符：%s\n' "$0" "$problems" >&2
    exit 1
  fi
  printf 'dependency table matches the manifests (%s crates)\n' "$(printf '%s\n' "$listed" | wc -l | tr -d ' ')"
  exit 0
fi

published=""
skipped=""
failed=""

for level in $levels; do
  pending=""
  for crate in $level; do
    deps=$(deps_of "$crate")
    missing=""
    for dep in $deps; do
      if ! is_published "$dep" "$workspace_version"; then
        missing="$missing $dep"
      fi
    done
    if [ -n "$missing" ]; then
      if [ "$publish" = true ]; then
        echo "error: cannot publish $crate: waiting for$missing" >&2
        exit 1
      fi
      printf 'warn: skipping %s: versioned dependency not on %s yet:%s\n' \
        "$crate" "$index_url" "$missing" >&2
      skipped="$skipped $crate"
      continue
    fi
    pending="$pending $crate"
  done

  level_published=""
  for crate in $pending; do
    if [ "$publish" = true ]; then
      # A version already on the index is the outcome this run wants. Without
      # this check, a re-run after a partial publication asks `cargo publish` for
      # a crate it has already uploaded, reads the registry's "already uploaded"
      # 400 as a failure, and then refuses every crate that depends on it — so a
      # release that is one command away from correct gets reported as broken,
      # and there is no script-level way to resume.
      # index 上已有该版本，就已经是本次运行想要的结果。缺这道检查时，一次部分发布后的
      # 重跑会为已经上传过的 crate 再问一次 `cargo publish`，把 registry 的
      # "already uploaded" 400 读成失败，进而拒绝每一个依赖它的 crate——于是一次离正确
      # 只差一条命令的发布被报成坏的，而且没有脚本级的续跑方式。
      if is_published "$crate" "$workspace_version"; then
        printf 'already on the index %s %s\n' "$crate" "$workspace_version"
        level_published="$level_published $crate"
        continue
      fi
      printf 'publishing %s %s\n' "$crate" "$workspace_version"
      # shellcheck disable=SC2086
      if cargo publish -p "$crate" $cargo_flags; then
        level_published="$level_published $crate"
      else
        printf 'error: cargo publish failed for %s\n' "$crate" >&2
        failed="$failed $crate"
      fi
    else
      printf 'verifying %s %s\n' "$crate" "$workspace_version"
      # shellcheck disable=SC2086
      if cargo publish -p "$crate" --dry-run $cargo_flags; then
        level_published="$level_published $crate"
      else
        printf 'error: cargo publish --dry-run failed for %s\n' "$crate" >&2
        failed="$failed $crate"
      fi
    fi
  done

  # Wait for this level to be visible before the next one resolves against it.
  # Only the crates this level actually put on the index are waited for: a crate
  # that failed is not going to appear, and its dependents are refused by the
  # dependency check above rather than published against a gap.
  # 等这一层在 index 里可见，下一层才能解析到它。只等本层真正送上 index 的那些 crate：
  # 失败的那个不会出现，而它的依赖者会在上面的依赖检查里被拒绝，而不是带着缺口发布。
  if [ "$publish" = true ]; then
    for crate in $level_published; do
      waited=0
      while ! is_published "$crate" "$workspace_version"; do
        if [ "$waited" -ge "$wait_seconds" ]; then
          printf 'error: %s %s did not appear in %s within %ss; stopping before the next level\n' \
            "$crate" "$workspace_version" "$index_url" "$wait_seconds" >&2
          exit 1
        fi
        sleep 5
        waited=$((waited + 5))
      done
    done
  fi
  published="$published $level_published"
done

cat <<EOF
Publish summary (version $workspace_version)
  mode:      $([ "$publish" = true ] && echo publish || echo 'dry run')
  verified:${published:- none}
  skipped:${skipped:- none}
  failed:${failed:- none}
Skipped crates have a versioned nichlink-* dependency that is not on
$index_url yet; run this again after that dependency lands. After the real
publish, re-run tools/nichlink-package-audit: every crate becomes checkable, and
the CI step keeps validating all nine from then on.
跳过的 crate 有尚未发布到 $index_url 的 nichlink-* 版本依赖；该依赖上线后重跑本脚本。
真正发布之后重跑 tools/nichlink-package-audit：所有 crate 都变为可检查，CI 步骤从此持续
校验全部九个。
EOF

if [ -n "$failed" ]; then
  exit 1
fi
exit 0
