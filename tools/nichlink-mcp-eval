# ——那是它自己的抽取器失败，不是关卡的事实。
BASELINE = {
    1: ("post(", ""),
    2: ("audit", "audit = []"),
    3: ("fn audit_unused", ""),
    4: ("postable", ""),
    5: ("write_count", "then one line per entry"),
    6: ("postable", "and a zero"),
    7: ("1000", "SMALL_LIMIT"),
    8: ("write_count", "a header, the count"),
}


def scenario_baseline(directory):
    """How far a plain `grep` plus reading the hits gets, per scenario.
    \u6bcf\u4e00\u5173\u91cc\u201c\u53ea\u7528 grep \u52a0\u9605\u8bfb\u547d\u4e2d\u6587\u4ef6\u201d\u80fd\u8d70\u591a\u8fdc\u3002

    A question a plain reader can settle from one grep is **not discriminating**, whatever a tool's
    answer costs, and it is reported that way rather than counted as a win. The two numbers are: how
    many files that grep must open, and whether the rule the answer needs is written in the tree at
    all — a level whose evidence is tree-local still discriminates on *finding it cheaply*.
    \u4e00\u4e2a\u7d20\u8bfb\u8005\u4e00\u6761 grep \u5c31\u80fd\u5b9a\u7684\u95ee\u9898\u201c\u4e0d\u5177\u9274\u522b\u529b\u201d\uff0c\u65e0\u8bba\u4e00\u4ef6\u5de5\u5177\u7b54\u5b83\u591a\u8d35\uff0c\u90fd\u5982\u5b9e\u8bb0\u6210
    \u201c\u4e0d\u5177\u9274\u522b\u529b\u201d\u3002\u4e24\u4e2a\u6570\u5b57\u662f\uff1a\u90a3\u6761 grep \u5fc5\u987b\u6253\u5f00\u51e0\u4e2a\u6587\u4ef6\uff0c\u4ee5\u53ca\u7b54\u6848\u6240\u9700\u7684\u89c4\u5219\u5230\u5e95\u6709\u6ca1\u6709\u5199\u5728\u6811\u91cc\u2014\u2014
    \u8bc1\u636e\u662f\u6811\u5185\u7684\u5173\u5361\u4f9d\u7136\u5728\u201c\u627e\u5f97\u5feb\u4e0d\u5feb\u201d\u8fd9\u4e00\u70b9\u4e0a\u6709\u9274\u522b\u529b\u3002
    """
    print(f"{'scenario':<26} {'files a grep must open':<24} {'rule written in the tree':<24}")
    for number, scenario in sorted(SCENARIOS.items()):
        target = os.path.join(directory, f"s{number}")
        scenario_project(target)
        scenario_inject(target, number)
        pattern, rule = BASELINE[number]
        found = subprocess.run(
            ["grep", "-rln", "--include=*.rs", "-F", pattern, "."],
            cwd=target,
            capture_output=True,
            text=True,
        )
        files = [line for line in found.stdout.splitlines() if line.strip()]
        stated = "n/a"
        if rule:
            hit = subprocess.run(
                ["grep", "-rq", "--include=*.rs", "-F", rule, "."],
                cwd=target,
                capture_output=True,
                text=True,
            )
            stated = "yes" if hit.returncode == 0 else "no"
        flag = "" if len(files) > 1 else "  <- one grep settles it"
        print(f"{number}. {scenario['id']:<23} {len(files):<24} {stated:<24}{flag}")
    return 0


def scenario_probe(directory, binary):
    """Run both tools on every scenario tree and score them mechanically.
    \u5728\u6bcf\u4e00\u68f5\u60c5\u666f\u6811\u4e0a\u8dd1\u4e24\u4ef6\u5de5\u5177\uff0c\u5e76\u673a\u68b0\u5224\u5206\u3002"""
    print(f"{'scenario':<26} {'ours':<30} {'codegraph':<34}")
    for number, scenario in sorted(SCENARIOS.items()):
        target = os.path.join(directory, f"s{number}")
        scenario_project(target)
        scenario_inject(target, number)
        probe = PROBES[number]
        ours = run_cli(target, binary, probe["ours"])
        ours_ok = all(needle in ours["text"] for needle in probe["expect_ours"])
        ours_note = f"{ours['calls']} calls {'OK' if ours_ok else 'WRONG'}"
        if not ours_ok:
            ours_note += " (" + ours["text"].replace("\n", " ")[:60] + ")"
        codeg = run_codegraph(target, probe["codegraph"])
        # `NO-EQUIVALENT-EXPECTED` is not a wrong answer: it records that the question has no
        # counterpart in that tool at all, which is a different fact from answering it badly.
        # 这个哨兵不是"答错"：它记的是那件工具根本没有这一问的对应物，与"答得差"是两件事。
        absent = probe["expect_codegraph"] == ["NO-EQUIVALENT-EXPECTED"]
        codeg_ok = all(needle in codeg["text"] for needle in probe["expect_codegraph"])
        if absent:
            codeg_note = f"{codeg['calls']} calls no equivalent"
        else:
            codeg_note = f"{codeg['calls']} calls {'OK' if codeg_ok else 'WRONG'}"
        print(f"{number}. {scenario['id']:<23} {ours_note:<30} {codeg_note:<34}")
    return 0


def run_cli(target, binary, calls):
    """Run one-shot client calls in the tree; the answer is every call's stdout.
    \u5728\u6811\u91cc\u8dd1\u4e00\u6b21\u6027\u5ba2\u6237\u7aef\u8c03\u7528\uff1b\u7b54\u6848\u662f\u6bcf\u6b21\u8c03\u7528\u7684 stdout\u3002"""
    text = ""
    for call in calls:
        done = subprocess.run([binary, *call], cwd=target, capture_output=True, text=True)
        text += done.stdout + done.stderr
    return {"calls": len(calls), "text": text}


def run_codegraph(target, calls):
    """Run codegraph commands in the tree, after one index.
    \u5148\u5efa\u7d22\u5f15\uff0c\u518d\u5728\u6811\u91cc\u8dd1 codegraph \u547d\u4ee4\u3002"""
    env = dict(os.environ, PATH=os.path.expanduser("~/.local/bin") + os.pathsep + os.environ["PATH"])
    text = ""
    count = 0
    for command in [["init"]] + calls:
        done = subprocess.run(
            ["codegraph", *command], cwd=target, capture_output=True, text=True, env=env
        )
        text += done.stdout + done.stderr
        count += 1
    return {"calls": count, "text": text}


def scenario_project(directory):
    """Write the workspace the scenario levels are asked about.
    \u5199\u51fa\u60c5\u666f\u5173\u5361\u6240\u95ee\u7684\u90a3\u4e2a\u5de5\u4f5c\u533a\u3002"""
    if os.path.exists(directory):
        shutil.rmtree(directory)
    for name, text in WORKSPACE.items():
        path = os.path.join(directory, name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(text)
    print(f"scenario workspace written: {directory} ({len(WORKSPACE)} files)")


def scenario_inject(directory, number):
    """Apply the state a scenario asks about.
    \u5e94\u7528\u4e00\u4e2a\u60c5\u666f\u6240\u95ee\u7684\u72b6\u6001\u3002"""
    scenario = SCENARIOS[number]
    for relative, old, new in scenario["inject"]:
        path = os.path.join(directory, relative)
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
        if text.count(old) != 1:
            raise SystemExit(f"scenario {number}: anchor matched {text.count(old)} times in {relative}")
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(text.replace(old, new, 1))
    print(f"scenario {number} ({scenario['id']}) applied: {len(scenario['inject'])} site(s)")


def scenario_plan():
    # The round protocol is printed with the levels, so it travels with them instead of living in
    # whatever the captain remembers when writing briefs. Two of the queue's items are protocol
    # rather than code: the orphan view has to be exercised by a question whose shortest route *is*
    # it, and every call has to be logged raw, because summary lines cannot be recomputed from.
    # 轮次协议与关卡一起打印，因此它随关卡走，而不是留在队长写题面时的记忆里。队列里有两项属于协议而不是
    # 代码：孤儿视图必须由一个"它本身就是最短路"的问题来触达；每一次调用都必须留**原始**记录，因为摘要行
    # 无法被复算。
    print("Round protocol / 轮次协议:")
    print("  - briefs carry the question and the symptom only, never the preset answer")
    print("    题面只给问题与症状，绝不给预设答案")
    print("  - every call is logged raw: {\"request\": …, \"response\": …, \"exit\": N} per line")
    print("    每次调用留原始记录：每行一条 {request, response, exit}")
    print("  - scenario 3 is the orphan view's own question: its shortest route is that view")
    print("    第 3 关是孤儿视图自己的问题：它本身就是最短路")
    print("  - the trees are read-only for the answerer")
    print("    答题方对题树只读")
    print()
    print("Scenario levels: the shapes a real workspace has.\n")
    for number, scenario in sorted(SCENARIOS.items()):
        print(f"{number}. {scenario['id']}")
        print(f"   question: {scenario['question']}")
        print(f"   preset answer: {scenario['answer']}")
        print(f"   codegraph: {scenario['codegraph']}")
        print(f"   sites: {len(scenario['inject'])}")
        print()


def scenario_check(directory):
    """Prove each scenario's question is real on its tree: the suite and the tool can see it.
    \u5728\u771f\u6811\u4e0a\u8bc1\u660e\u6bcf\u4e00\u5173\u7684\u95ee\u9898\u662f\u771f\u7684\u3002"""
    ok = True
    for number, scenario in sorted(SCENARIOS.items()):
        target = os.path.join(directory, f"s{number}")
        scenario_project(target)
        scenario_inject(target, number)
        default = test(target)
        audit = subprocess.run(
            ["cargo", "test", "--offline", "--features", "ledger-core/audit", "--quiet"],
            cwd=target,
            capture_output=True,
            text=True,
        )
        print(
            f"  s{number} {scenario['id']:<26} default-face rc={default.returncode} "
            f"audit-face rc={audit.returncode}"
        )
        if number == 2 and default.returncode != 0:
            print("    !! scenario 2 needs its red to be invisible on the default face")
            ok = False
        if number == 2 and audit.returncode == 0:
            print("    !! scenario 2's audit face must be red")
            ok = False
        if number in (1, 3, 4, 6) and audit.returncode != 0:
            print(f"    !! scenario {number}'s audit face must be green on the pristine fixtures")
            ok = False
        if number in (7, 8) and default.returncode == 0:
            print(f"    !! scenario {number} must be red on the default face")
            ok = False
        if number == 5 and default.returncode == 0:
            print("    !! scenario 5 must be red on the default face")
            ok = False
        if number in (1, 3, 4, 6) and default.returncode != 0:
            print(f"    !! scenario {number} must be green on the default face")
            ok = False
    print("scenario shapes verified" if ok else "scenario shapes FAILED")
    return 0 if ok else 1


def write_project(directory):
    if os.path.exists(directory):
        shutil.rmtree(directory)
    for name, text in PROJECT.items():
        path = os.path.join(directory, name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(text)
    print(f"project written: {directory} ({len(PROJECT)} files)")


def inject(directory, number):
    bug = BUGS[number]
    path = os.path.join(directory, bug["file"])
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    old, new = bug["replace"]
    if text.count(old) != 1:
        raise SystemExit(f"bug {number}: anchor matched {text.count(old)} times in {bug['file']}")
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text.replace(old, new, 1))
    line = text[: text.find(old)].count("\n") + 1
    print(f"bug {number} ({bug['id']}) injected: {bug['file']}:{line} {bug['symbol']}")


def test(directory, filter_=None):
    args = ["cargo", "test", "--offline", "--quiet"]
    if filter_:
        args += ["--", filter_]
    return subprocess.run(args, cwd=directory, capture_output=True, text=True)


def check(directory, number):
    """Prove the designed bug is real: pristine green, injected red, fixed green."""
    bug = BUGS[number]
    pristine = os.path.join(directory, "pristine")
    write_project(pristine)
    green = test(pristine)
    if green.returncode != 0:
        print(green.stdout[-2000:], green.stderr[-2000:])
        raise SystemExit("the pristine project does not pass its own tests")
    print("pristine: tests pass")

    injected = os.path.join(directory, f"round-{number}")
    write_project(injected)
    inject(injected, number)
    red = test(injected)
    if red.returncode == 0:
        raise SystemExit(f"bug {number} does not show up as a failure")
    named = bug["failing_test"] in red.stdout + red.stderr
    print(f"injected: fails (the designed test named: {named})")
    if not named:
        print(red.stdout[-3000:])
        raise SystemExit(f"bug {number} fails, but not the test this bug was designed to fail")

    old, new = bug["replace"]
    path = os.path.join(injected, bug["file"])
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    if text.count(new) != 1:
        raise SystemExit("the documented fix anchor is not the injected text")
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text.replace(new, old, 1))
    fixed = test(injected)
    if fixed.returncode != 0:
        print(fixed.stdout[-2000:])
        raise SystemExit("the documented fix does not restore the suite")
    print("documented fix: tests pass")
    print(f"bug {number} verified: symptom real, fix exact, shortcut named: {bug['cheat']}")


def plan():
    print("Designed bugs and their preset ideal debug paths.\n")
    for number, bug in sorted(BUGS.items()):
        print(f"{number}. {bug['id']}  ({bug['layer']})  {bug['file']}::{bug['symbol']}")
        print(f"   symptom: {bug['symptom']} — fails `{bug['failing_test']}`")
        print(f"   shortcut to refuse: {bug['cheat']}")
        for step in bug["preset_path"]:
            print(f"   - {step}")
        print()


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    command = argv[1]
    if command == "project":
        write_project(argv[2])
    elif command == "inject":
        inject(argv[2], int(argv[3]))
    elif command == "check":
        check(argv[2], int(argv[3]))
    elif command == "plan":
        plan()
    elif command == "scenario-project":
        scenario_project(argv[2])
    elif command == "scenario-inject":
        scenario_inject(argv[2], int(argv[3]))
    elif command == "scenario-plan":
        scenario_plan()
    elif command == "scenario-check":
        return scenario_check(argv[2])
    elif command == "scenario-baseline":
        return scenario_baseline(argv[2])
    elif command == "scenario-probe":
        return scenario_probe(argv[2], argv[3])
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
