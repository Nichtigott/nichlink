    "src/query/filter.rs": """//! Filtering entries.
//! 过滤分录。

use crate::model::entry::Entry;

/// Which entries a caller wants.
/// 调用方想要哪些分录。
#[derive(Clone, Debug, Default)]
pub struct Filter {
    /// Only entries for this account, when set.
    /// 只保留该账户的分录（若设置）。
    pub account: Option<String>,
    /// Only entries at or above this amount, when set.
    /// 只保留不小于该金额的分录（若设置）。
    pub min_amount: Option<i64>,
    /// Only entries with a receipt, when set.
    /// 只保留带凭据的分录（若设置）。
    pub receipts_only: bool,
}

impl Filter {
    /// Whether this entry passes.
    /// 本分录是否通过。
    pub fn matches(&self, entry: &Entry) -> bool {
        if let Some(account) = &self.account
            && &entry.account != account
        {
            return false;
        }
        if let Some(min) = self.min_amount
            && entry.amount < min
        {
            return false;
        }
        if self.receipts_only && !entry.has_receipt {
            return false;
        }
        true
    }
}
