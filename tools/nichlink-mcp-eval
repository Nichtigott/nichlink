use crate::query::summary::Summary;

/// Render one summary: a header, the totals, then one line per bucket.
/// 渲染一份汇总：表头、合计，然后每个桶一行。
pub fn render(summary: &Summary) -> String {
    let mut text = String::from("LEDGER REPORT\\n");
    write_totals(&mut text, summary);
    for (name, count) in &summary.per_bucket {
        text.push_str(&format!("bucket {name}: {count}\\n"));
    }
    text
}

/// The totals block: entries counted and the sum.
/// 合计块：计入条数与金额合计。
///
/// Split out because a report with a totals block and no bucket lines is exactly
/// what a caller sees when the bucket walk is skipped, and keeping the two in
/// separate functions is what lets the tests name which half went missing.
/// 单独拆出，是因为"有合计块、没有分桶行"正是调用方在分桶遍历被跳过时看到的东西，而把两者放在不同函数里
/// 正是让测试能点名少了哪一半的原因。
pub fn write_totals(text: &mut String, summary: &Summary) {
    text.push_str(&format!("entries: {}\\n", summary.count));
    text.push_str(&format!("total: {}\\n", summary.total));
}
