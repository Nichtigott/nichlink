    "src/store/index.rs": """//! Bucketing entries by amount for reports.
//! 按金额把分录分桶，供报表使用。

/// One bucket: a half-open range of amounts.
/// 一个桶：一段半开区间的金额。
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Bucket {
    /// Inclusive lower bound.
    /// 含下界。
    pub low: i64,
    /// Exclusive upper bound; `None` means unbounded.
    /// 不含上界；`None` 表示无上界。
    pub high: Option<i64>,
}

impl Bucket {
    /// Whether this bucket holds an amount: at or above `low`, below `high` when it has one.
    /// 本桶是否容纳某个金额：不小于 `low`，有上界时严格小于它。
    pub fn contains(&self, amount: i64) -> bool {
        if amount < self.low {
            return false;
        }
        match self.high {
            Some(high) => amount < high,
            None => true,
        }
    }
}

/// The three buckets every report uses.
/// 每份报表都用的三个桶。
pub fn buckets() -> Vec<Bucket> {
    vec![
        Bucket { low: i64::MIN, high: Some(0) },
        Bucket { low: 0, high: Some(1000) },
        Bucket { low: 1000, high: None },
    ]
}

/// Which bucket a bucket-list places this amount in, by name.
/// 一组桶把这个金额放进哪个桶，按名字给出。
pub fn bucket_of(buckets: &[Bucket], amount: i64) -> &'static str {
    for (index, bucket) in buckets.iter().enumerate() {
        if bucket.contains(amount) {
            return match index {
                0 => "debit",
                1 => "small",
                _ => "large",
            };
        }
    }
    "unbucketed"
}
