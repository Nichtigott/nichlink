    command = argv[1]
    if command == "project":
        write_project(argv[2])
    elif command == "inject":
        inject(argv[2], int(argv[3]))
    elif command == "check":
        check(argv[2], int(argv[3]))
    elif command == "plan":
        plan()
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
