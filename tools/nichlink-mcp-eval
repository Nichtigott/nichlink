    "src/query/summary.rs": """//! Summaries over a filtered set.
//! 对过滤后集合的汇总。

use crate::model::entry::Entry;
use crate::store::index::{buckets, bucket_of};

/// A summary of entries.
/// 分录的汇总。
#[derive(Debug, PartialEq, Eq, Default)]
pub struct Summary {
    /// Number of entries counted.
    /// 计入的分录数。
    pub count: usize,
    /// Sum of the amounts.
    /// 金额合计。
    pub total: i64,
    /// How many landed in each bucket, by bucket name.
    /// 每个桶各落了多少条，按桶名。
    pub per_bucket: Vec<(&'static str, usize)>,
}

/// Summarise entries that a predicate accepts.
/// 汇总谓词接受的那些分录。
pub fn summarise<'a, I>(entries: I, accept: impl Fn(&Entry) -> bool) -> Summary
where
    I: IntoIterator<Item = &'a Entry>,
{
    let buckets = buckets();
    let mut summary = Summary::default();
    for entry in entries {
        if !accept(entry) {
            continue;
        }
        summary.count += 1;
        summary.total += entry.amount;
        let name = bucket_of(&buckets, entry.amount);
        match summary.per_bucket.iter_mut().find(|(key, _)| *key == name) {
            Some((_, count)) => *count += 1,
            None => summary.per_bucket.push((name, 1)),
        }
    }
    summary.per_bucket.sort();
    summary
}
