use ledger_core::model::Entry;

/// Render the entries: a header, the count, then one line per entry.
/// 渲染分录：表头、条数，然后每条一行。
pub fn render(entries: &[Entry]) -> String {
    let mut text = String::from("LEDGER REPORT\n");
    write_count(&mut text, entries);
    for entry in entries {
        text.push_str(&format!("{}: {}\n", entry.account, entry.amount));
    }
    text
}

/// The count block.
/// 条数块。
pub fn write_count(text: &mut String, entries: &[Entry]) {
    text.push_str(&format!("entries: {}\n", entries.len()));
}
