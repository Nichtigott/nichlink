#!/bin/sh
# Rehearse a crate partition end to end: **both shapes build**, and the four acceptance facts the
# maintainer fixed hold byte for byte.
# 端到端演练一次 crate 拆分：**两个形状都构建**，而维护者定下的四条验收事实逐字节成立。
#
#   tools/nichlink-partition-rehearsal
#   NICHLINK_REHEARSAL_CARGO_FLAGS="" tools/nichlink-partition-rehearsal
#
# Why it exists: the partition (`nichlink crates --write`, the `add_crates.rs` declaration, the ghost
# and facade packages) was verified by hand for three batches — and every defect it ever had was found
# by *doing the whole thing once*: the mount spelling that cannot be relative, the two cross-crate
# references the facade had to rewrite, the host emitting a graft table for a face it had handed away,
# the reachability check refusing the scaffold's own imports, the implementation file layout `promote`
# could not find, and a remap written where cargo never reads it (audit `M7`, §M7.37–§M7.40). Hand runs
# leave nothing behind; this script leaves a gate.
# 为什么需要它：拆分（`nichlink crates --write`、`add_crates.rs` 声明、幽灵与 facade 两个包）被手工验证了
# 三个批次——而它曾有过的每一个缺陷都是**把整件事完整做一遍**才发现的：不可能相对的挂载拼写、facade 必须改写
# 的两处跨 crate 引用、宿主为已经交出去的切口面发 graft 表、可达性检查拒绝脚手架自己的导入、`promote` 找不到
# 的实现文件版式、以及写在 cargo 永远不会读的地方的 remap（审计 `M7`，§M7.37–§M7.40）。手工跑什么都不留下；
# 这个脚本留下的是一道门禁。
#
# Six legs, because the shapes are different code paths:
#   1. **workspace** — the host is a member of a workspace, the generated packages have to be
#      materialized into its `members`, and the unpartitioned tree, the host's partitioned tree, the
#      ghost's tree and the facade's tree have to carry the same graft plan and the same identities;
#   2. **standalone** — nothing above the host is a workspace, so the remap belongs to the directory the
#      host and its generated siblings share (measured: writing it inside the host left every mounted
#      face failing `assert_static_identity`, §M7.40);
#   3. **promote on a partitioned tree** — a scaffolded host (`new_project` writes faces the authoring
#      executor owns) that is partitioned *and* has a graft record landed into it;
#   4. **release** — the same partition written so the packages can be published: each carries the
#      sources its build reads, so nothing is mounted out of another package and no remap is involved;
#   5. **the committed example** — the four legs above build fixtures this script writes itself, so
#      `examples/partitioned-button` is the leg that keeps a *real* partitioned host in the repository;
#   6. **re-partitioning** — the author's graft plan is written once and the crate boundary under it
#      moves twice; every shape must still build with the same cut. That is the property cross-crate
#      grafts were asked for: 「跨crate graft是为了防止后续crate调整导致的graft失效」.
# 六条腿，因为各种形状是彼此不同的代码路径：
#   1. **工作区**——宿主是某个工作区的成员，生成的包必须被物化进它的 `members`，而不分区的树、宿主分区后的树、
#      幽灵的树与 facade 的树必须带同样的 graft 计划与同样的身份；
#   2. **独立**——宿主之上没有任何工作区，因此 remap 属于宿主与它生成的同级包共同拥有的那个目录（实测：写在
#      宿主里面时，每个被挂载的面都在 `assert_static_identity` 上失败，§M7.40）；
#   3. **在分区树上 promote**——一个脚手架建出来的宿主（`new_project` 写的注册面归创作执行器所有）既被分区，
#      又落下一条 graft 记录；
#   4. **发布**——同一次拆分写成可发布的样子：每个包携带自己构建要读的源码，因此没有任何东西从别的包挂载出来，
#      也不牵涉任何 remap；
#   5. **入库示例**——上面四条腿构建的都是本脚本自己写出来的夹具，因此 `examples/partitioned-button` 才是把
#      一棵**真的**被划分过的宿主留在仓库里的那条腿；
#   6. **重新划分**——作者的 graft 计划只写一次，它下面的 crate 边界搬两次；每一种形状都必须带着同一条切口
#      构建得过。这正是跨 crate graft 被要去的那个性质：「跨crate graft是为了防止后续crate调整导致的graft失效」。
#
# The three trees are taken through `check` with the same environment the generated build scripts set
# (`NICH_LINK_SHAPE_ONLY`, `NICH_LINK_SHAPE_FACADE`), because that is the same pipeline the build runs —
# and the cargo build below is what proves the trees compile. Nothing here guesses at cargo's hashed
# build directories.
# 三棵树是通过 `check` 加生成构建脚本所设的同一套环境变量（`NICH_LINK_SHAPE_ONLY`、`NICH_LINK_SHAPE_FACADE`）
# 取得的，因为那就是构建所跑的同一套管线——而下面的 cargo build 正是证明这些树编译得过的东西。这里没有任何
# 地方去猜 cargo 带哈希的构建目录。
#
# It needs no network when the registry cache is warm, which is why the flag below defaults to
# `--offline` and CI, which has a network, can set it empty.
# 注册表缓存是热的时候它不需要网络，这正是下面那个标志默认 `--offline`、而有网络的 CI 可以把它置空的原因。

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CARGO_FLAGS="${NICHLINK_REHEARSAL_CARGO_FLAGS---offline}"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM

step() { echo "== $1" >&2; }
fail() { echo "partition rehearsal FAILED: $1" >&2; exit 1; }
# shellcheck disable=SC2086  # the flags are a deliberate word list
build() { command cargo build $CARGO_FLAGS "$@"; }

step "building the checkout's CLI and bridge"
build -p nichlink-toolchain --features cli,mcp --bin nichlink --bin nichlink-mcp \
  --manifest-path "$ROOT/Cargo.toml"
NICHLINK="$ROOT/target/debug/nichlink"
# Build the binary this script drives, rather than assuming somebody else did. A fresh checkout has
# no `target/debug/nichlink`, and a gate that only passes on a machine where it was built by hand
# fails on exactly the machine that matters — measured: CI red on a commit whose local run was green.
# 自己构建本脚本要驱动的二进制，而不是假设别人已经构建过。全新检出不带 `target/debug/nichlink`，
# 而一道只在"有人手工构建过"的机器上通过的闸门，恰恰会在最要紧的那台机器上失败——实测：一笔本地全绿的
# 提交在 CI 上红。
if [ ! -x "$NICHLINK" ]; then
  step "building the CLI this rehearsal drives"
  build -p nichlink-toolchain --features cli --bin nichlink || fail "cannot build $NICHLINK"
fi
BRIDGE="$ROOT/target/debug/nichlink-mcp"

# The implementation crate every fixture grafts onto. Its face lives at `src/fast/fast.rs`, i.e. the
# module `fast` — the layout this repository's own generator writes.
# 每个夹具都嫁接到的实现 crate。它的注册面住在 `src/fast/fast.rs`，也就是模块 `fast`——本仓库自己的生成器
# 写出的那种版式。
write_fast_widget() {
  mkdir -p "$1/src/fast"
  cat >"$1/Cargo.toml" <<EOF
[package]
name = "fast-widget"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
nichlink-toolchain = { path = "$ROOT/toolchain", features = ["run"] }

[build-dependencies]
nichlink-toolchain = { path = "$ROOT/toolchain", features = ["build"] }
EOF
  cat >"$1/build.rs" <<'EOF'
fn main() {
    println!("cargo:rerun-if-changed=src");
    nichlink_toolchain::build_method::run();
}
EOF
  cat >"$1/src/lib.rs" <<'EOF'
nichlink_toolchain::run_method::host!();
EOF
  cat >"$1/src/fast/fast.rs" <<'EOF'
//! 项目外的 Widget 实现。
//! The out-of-project replacement for Widget.

use nichlink_toolchain::run_method::registry_core::{
    ContractId, FlowContract, NoParts, NoPreset, RegistrationRule, root_node_id,
};

pub struct WidgetFast;

nichlink_toolchain::run_method::external_object! {
    source: "fast/fast.rs",
    kind: WidgetFast,
    preset: NoPreset,
    parts: NoParts,
    name: { zh: "快速控件", en: "Fast widget" },
    summary: { zh: "项目外实现", en: "Out-of-project implementation" },
    exports: ["panel.render"],
    needs_registry: false,
    parent: root_node_id(crate::NICHLINK_NAMESPACE),
    getting_from_other_registry: None,
    registry_rule_path: "fast.rs",
    registry_rule: RegistrationRule::ANY,
    requires: [],
    provides: [],
    flow: FlowContract::new(
        ContractId::new("panel.render.v1"),
        1,
        "PanelInput",
        "PanelFrame",
    ),
    runtime_checks: [],
}
EOF
}

# The declaration that makes the split: `panel::frame` is handed to a crate of its own.
# 让拆分成立的声明：`panel::frame` 被交给一个属于它自己的 crate。
write_declaration() {
  cat >"$1/add_crates.rs" <<'EOF'
//! The crate shape this hosted tree declares.
//! 这棵宿主树声明的 crate 形状。

use nichlink_toolchain::run_method::{Crate, Shape};

pub fn add_crates() -> Shape {
    Shape {
    package_prefix: "app",
    crates: &[
        Crate::named("widgets").at(&[crate::panel::frame::SUBTREE]),
    ],
}
}
EOF
}

# A self-contained host: `panel` (root face) → `panel::frame` (owns a registry) → `panel::frame::widget`,
# with a typed graft cut on the leaf. `$2` is its package name, `$3` is `yes` when the manifest has to be
# its own workspace root (what `new_project` writes).
# 一个自足的宿主：`panel`（根面）→ `panel::frame`（拥有注册机）→ `panel::frame::widget`，叶子带一条类型化
# graft 切口。`$2` 是包名，`$3` 为 `yes` 时清单要自带 `[workspace]` 表（也就是 `new_project` 写的样子）。
write_host() {
  mkdir -p "$1/src/panel/frame/widget" "$1/src/panel/frame/registry_rule" "$1/src/panel/registry_rule"
  {
    if [ "$3" = "yes" ]; then
      printf '[workspace]\n\n'
    fi
    cat <<EOF
[package]
name = "$2"
version = "0.1.0"
edition = "2024"

[dependencies]
nichlink-toolchain = { path = "$ROOT/toolchain", features = ["run"] }
fast-widget = { path = "../fast-widget" }

[build-dependencies]
nichlink-toolchain = { path = "$ROOT/toolchain", features = ["build"] }
EOF
  } >"$1/Cargo.toml"
  cat >"$1/build.rs" <<'EOF'
fn main() {
    println!("cargo:rerun-if-changed=src");
    nichlink_toolchain::build_method::run();
}
EOF
  cat >"$1/src/lib.rs" <<'EOF'
nichlink_toolchain::run_method::host!();

pub const FRAMEWORK: FrameworkId = FrameworkId::new("nichlink.rehearsal.partition");

nichlink_toolchain::run_method::static_graft_plan!(
    FRAMEWORK,
    cut(crate::panel::frame::widget::NODE_ID) graft(fast_widget::fast::NODE_ID),
);
EOF
  cat >"$1/src/panel/panel.rs" <<'EOF'
crate::root_object! {
    kind: Panel,
    needs_registry: true,
    parent: crate::root_node_id(crate::NICHLINK_NAMESPACE),
}
EOF
  cat >"$1/src/panel/registry_rule/registry_rule.rs" <<'EOF'
//! Panel 对直接子对象的最低结构要求。
//! Panel's minimum structure for a direct child.

use crate::RegistrationRule;

pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new();
EOF
  cat >"$1/src/panel/frame/frame.rs" <<'EOF'
crate::panel_object! {
    kind: Frame,
    needs_registry: true,
    parent: crate::panel::NODE_ID,
}
EOF
  cat >"$1/src/panel/frame/registry_rule/registry_rule.rs" <<'EOF'
//! Frame 对直接子对象的最低结构要求。
//! Frame's minimum structure for a direct child.

use crate::RegistrationRule;

pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new();
EOF
  cat >"$1/src/panel/frame/widget/widget.rs" <<'EOF'
crate::frame_object! {
    kind: Widget,
    parent: crate::panel::frame::NODE_ID,
}
EOF
}

# Every `crate::` path a host's mounted faces use, with whitespace removed, for a byte comparison.
# 宿主每个被挂载面用到的 `crate::` 身份断言，去掉空白，用于逐字节比较。
cut_identity() {
  line=$(grep 'assert_static_identity(crate::panel::frame::widget::NODE_ID' "$1/generated_lib.rs" || true)
  [ -n "$line" ] || fail "no identity assertion for the cut face in $1"
  printf '%s' "$line" | tr -d ' '
}

# ============================================================ leg 1: the workspace shape
step "leg 1/4: a host inside a workspace"

WS="$WORK/ws"
mkdir -p "$WS"
# A workspace the user maintains: a comment, a multi-line list, and another table after it. The merge
# has to leave every one of those alone.
# 一份用户维护的工作区：一条注释、一份多行清单，后面还有别的表。合并必须把它们一个都不动。
cat >"$WS/Cargo.toml" <<'EOF'
# a workspace the user maintains
[workspace]
resolver = "3"
members = [
    "app",
    "fast-widget",
]

[workspace.package]
version = "0.1.0"
EOF
cp "$WS/Cargo.toml" "$WORK/ws-manifest-before"
write_fast_widget "$WS/fast-widget"
write_host "$WS/app" app no
OUT="$WS/app/target/nichlink/out"

step "leg 1: the unpartitioned baseline (one crate, no declaration)"
"$NICHLINK" check "$WS/app" >/dev/null || fail "the unpartitioned host does not check"
cp -R "$OUT" "$WORK/base-out"

step "leg 1: the three shapes of the partitioned tree"
write_declaration "$WS/app"
# The host's own sources are what ① compares, and the declaration is part of what the host's tree is —
# so the baseline for it is taken with the declaration in place.
# ① 比较的是宿主自己的源码，而声明是宿主这棵树的一部分——因此基准是在声明就位之后取的。
(cd "$WS/app" && find src -type f | sort | xargs sha256sum) >"$WORK/host-before.sha256"
sha256sum "$WS/app/Cargo.toml" "$WS/app/build.rs" >>"$WORK/host-before.sha256"

"$NICHLINK" check "$WS/app" >/dev/null || fail "the partitioned host does not check"
cp -R "$OUT" "$WORK/host-out"
NICH_LINK_SHAPE_ONLY=panel::frame "$NICHLINK" check "$WS/app" >/dev/null ||
  fail "the ghost shape does not check"
cp -R "$OUT" "$WORK/ghost-out"
NICH_LINK_SHAPE_FACADE=1 "$NICHLINK" check "$WS/app" >/dev/null ||
  fail "the facade shape does not check"
cp -R "$OUT" "$WORK/facade-out"

# ② The graft plan is the same data in every shape: the declaration did not move, so the cut, the graft
# and the `full` flag cannot differ.
# ② graft 计划在每个形状里都是同一份数据：声明没有搬家，因此切口、替换与 `full` 不可能不同。
for shape in host ghost facade; do
  cmp "$WORK/base-out/graft_plan.tsv" "$WORK/$shape-out/graft_plan.tsv" ||
    fail "② the graft plan differs in the $shape shape"
done

# ③ Identity is unchanged: the facade carries the union of the faces with byte-identical triples, and the
# cut face baked into the ghost is the one the unpartitioned build baked.
# ③ 身份不变：facade 携带面的并集、三元组逐字节相同，而烤进幽灵的切口面就是不分区构建烤进去的那一个。
grep -o 'StaticFace::new([^;]*),' "$WORK/base-out/generated_lib.rs" | sort >"$WORK/base.faces"
grep -o 'StaticFace::new([^;]*),' "$WORK/facade-out/generated_lib.rs" | sort >"$WORK/facade.faces"
cmp "$WORK/base.faces" "$WORK/facade.faces" ||
  fail "③ the facade's face identities differ from the unpartitioned tree"
cut_identity "$WORK/base-out" >"$WORK/cut.base"
cut_identity "$WORK/ghost-out" >"$WORK/cut.ghost"
cmp "$WORK/cut.base" "$WORK/cut.ghost" ||
  fail "③ the cut face's identity moved when the subtree changed crates"
# A crate asserts only about the faces **it** compiles: the host keeps the one that stayed with it and
# drops the two it handed away; the ghost is the mirror image. Getting this wrong is what made the first
# partitioned build fail with `cannot find 'frame' in 'panel'` (audit `M7`, §M7.36).
# 一个 crate 只为**自己**编译的面做断言：宿主留着留给它的那一个、丢掉交出去的那两个；幽灵正好相反。搞错这一点
# 正是第一次分区构建报 `cannot find 'frame' in 'panel'` 的原因（审计 `M7`，§M7.36）。
if grep -q 'assert_static_identity(crate::panel::frame::NODE_ID' "$WORK/host-out/generated_lib.rs"; then
  fail "③ the host asserts about a face it handed away"
fi
if grep -q 'assert_static_identity(crate::panel::NODE_ID' "$WORK/ghost-out/generated_lib.rs"; then
  fail "③ the ghost asserts about a face that stayed with the host"
fi

step "leg 1: writing the partition"
# The plan is read from the published manifest, so publish the host's own shape again before planning.
# 规划读的是已发布的清单，因此在规划之前把宿主自己那一形状再发布一次。
"$NICHLINK" check "$WS/app" >/dev/null || fail "the partitioned host does not check"
"$NICHLINK" crates --write "$WS/app"

# ① The host's own sources are not touched: partitioning changes which crate compiles a face, never the
# face. The declaration file is the only thing that appears.
# ① 宿主自己的源码一个字节都没动：分区改的是"哪个 crate 编译某个面"，从不是那个面。唯一新增的是声明文件。
(cd "$WS/app" && find src -type f | sort | xargs sha256sum) >"$WORK/host-after.sha256"
sha256sum "$WS/app/Cargo.toml" "$WS/app/build.rs" >>"$WORK/host-after.sha256"
cmp "$WORK/host-before.sha256" "$WORK/host-after.sha256" ||
  fail "① the host's sources changed during --write"

# The generated packages are materialized into the workspace's member list, and the remap lands in the
# config cargo reads from the workspace root.
# 生成的包被物化进工作区的成员清单，而 remap 落在 cargo 从工作区根读取的那份配置里。
grep -q '"crates/app-widgets"' "$WS/Cargo.toml" || fail "the ghost is not a workspace member"
grep -q '"crates/app-facade"' "$WS/Cargo.toml" || fail "the facade is not a workspace member"
grep -q '\[workspace.package\]' "$WS/Cargo.toml" || fail "the merge ate another table"
grep -q '# a workspace the user maintains' "$WS/Cargo.toml" || fail "the merge ate a comment"
[ -f "$WS/.cargo/config.toml" ] || fail "the remap is not at the workspace root"

step "leg 1: building the partitioned tree from the workspace root"
(cd "$WS" && build -p app-facade) || fail "the partitioned workspace does not build"

step "leg 1: idempotence and revert"
"$NICHLINK" crates --write "$WS/app" >/dev/null
(cd "$WS/app" && find src -type f | sort | xargs sha256sum) >"$WORK/host-twice.sha256"
sha256sum "$WS/app/Cargo.toml" "$WS/app/build.rs" >>"$WORK/host-twice.sha256"
cmp "$WORK/host-after.sha256" "$WORK/host-twice.sha256" || fail "a second --write changed something"

"$NICHLINK" crates --revert "$WS/app" >/dev/null
cmp "$WORK/ws-manifest-before" "$WS/Cargo.toml" ||
  fail "the revert did not restore the workspace manifest byte for byte"
[ ! -d "$WS/crates/app-widgets" ] || fail "the revert left the ghost behind"
[ ! -d "$WS/crates/app-facade" ] || fail "the revert left the facade behind"
[ ! -f "$WS/.cargo/config.toml" ] || fail "the revert left the remap behind"
(cd "$WS" && command cargo metadata $CARGO_FLAGS --no-deps --format-version 1 >/dev/null) ||
  fail "the workspace does not load after the revert"

# ============================================================ leg 2: the standalone shape
step "leg 2/4: a host with no enclosing workspace"

SOL="$WORK/sol"
mkdir -p "$SOL"
write_fast_widget "$SOL/fast-widget"
write_host "$SOL/app" app yes
write_declaration "$SOL/app"

"$NICHLINK" check "$SOL/app" >/dev/null || fail "the standalone host does not check"
"$NICHLINK" crates --write "$SOL/app" >/dev/null

[ -f "$SOL/.cargo/config.toml" ] ||
  fail "the remap is not in the directory the host and its siblings share"
[ ! -f "$SOL/app/.cargo/config.toml" ] ||
  fail "the remap was written where cargo never reads it while building a sibling"

step "leg 2: building the partitioned tree from the facade's own directory"
(cd "$SOL/crates/app-facade" && build) ||
  fail "the standalone partitioned tree does not build (the remap never reached the ghost)"

"$NICHLINK" crates --revert "$SOL/app" >/dev/null
[ ! -f "$SOL/.cargo/config.toml" ] || fail "the revert left the remap behind in the standalone shape"

# ============================================================ leg 3: promote on a partitioned tree
step "leg 3/4: promote landing into a partitioned tree"

PR="$WORK/promote"
mkdir -p "$PR"
write_fast_widget "$PR/fast-widget"
"$BRIDGE" --call new_project --json "{\"directory\":\"app\",\"package\":\"app\",\"kind\":\"library\",\"dependency\":\"path\",\"path\":\"$ROOT\",\"faces\":[{\"fields\":{\"module\":\"panel\",\"kind\":\"Panel\",\"needs_registry\":true}},{\"fields\":{\"module\":\"frame\",\"kind\":\"Frame\",\"needs_registry\":true},\"parent\":\"root/panel\"},{\"fields\":{\"module\":\"widget\",\"kind\":\"Widget\"},\"parent\":\"root/panel/frame\"}],\"apply\":true}" --root "$PR" >/dev/null ||
  fail "the scaffold did not run"

# The scaffold writes faces the authoring executor owns (that is what `promote` may rewrite) but no graft
# plan and no implementation dependency; both are the host author's to add, and `fast-widget` has to be a
# path dependency because the typed cut names it.
# 脚手架写出的注册面归创作执行器所有（这正是 `promote` 可以改写的东西），但它不写 graft 计划、也不写实现依赖；
# 两者都是宿主作者该加的，而 `fast-widget` 必须是一条 path 依赖，因为类型化切口点名了它。
sed 's|^\[build-dependencies\]|fast-widget = { path = "../fast-widget" }\n\n[build-dependencies]|' \
  "$PR/app/Cargo.toml" >"$PR/app/Cargo.toml.with-dep"
mv "$PR/app/Cargo.toml.with-dep" "$PR/app/Cargo.toml"
cat >>"$PR/app/src/lib.rs" <<'EOF'

pub const FRAMEWORK: FrameworkId = FrameworkId::new("nichlink.rehearsal.promote");

nichlink_toolchain::run_method::static_graft_plan!(
    FRAMEWORK,
    cut(crate::panel::object::frame::object::widget::NODE_ID) graft(fast_widget::fast::NODE_ID),
);
EOF
cat >"$PR/app/add_crates.rs" <<'EOF'
//! The crate shape this host declares.
use nichlink_toolchain::run_method::{Crate, Shape};

pub fn add_crates() -> Shape {
    Shape {
    package_prefix: "app",
    crates: &[Crate::named("widgets").at(&[crate::panel::object::frame::SUBTREE])],
}
}
EOF

"$NICHLINK" check "$PR/app" >/dev/null || fail "the scaffolded host does not check"
"$NICHLINK" crates --write "$PR/app" >/dev/null
(cd "$PR/crates/app-facade" && build) || fail "the scaffolded partition does not build before the promote"

# The record the landing consumes: its target is the identity the tool reports for the cut face, so the
# script never hard-codes a hash.
# 落地所消费的那条记录：它的目标是工具为切口面报出的身份，因此脚本从不硬编码哈希。
target=$("$NICHLINK" explain root/panel/frame/widget --path "$PR/app" | awk '/^node /{print $2; exit}')
[ -n "$target" ] || fail "could not read the cut face's identity"
mkdir -p "$PR/app/.nichlink/external-grafts/fast"
cat >"$PR/app/.nichlink/external-grafts/fast/graft.plan" <<EOF
version = 1
target = $target
target_path = root/panel/frame/widget
graft = fast
full = false
EOF

step "leg 3: previewing and landing the promote"
"$BRIDGE" --call apply --json '{"action":"promote","selector":"fast","confirm":true}' --root "$PR/app" >/dev/null ||
  fail "the promote preview was refused on the partitioned tree"
"$BRIDGE" --call apply --json '{"action":"promote","selector":"fast","confirm":true,"apply":true}' --root "$PR/app" >/dev/null ||
  fail "the promote did not land on the partitioned tree"

grep -q 'graft(crate::panel::object::frame::object::widget::NODE_ID)' "$PR/app/src/lib.rs" ||
  fail "the entry does not point the slot at the face itself after the landing"
[ -z "$(find "$PR/app/.nichlink/external-grafts" -mindepth 1 -maxdepth 1 2>/dev/null)" ] ||
  fail "the record was not retired"
[ -n "$(find "$PR/app/.nichlink/trash/external-grafts" -mindepth 1 -maxdepth 1 2>/dev/null)" ] ||
  fail "the record did not move to the trash"
(cd "$PR/crates/app-facade" && build) || fail "the tree does not build after the promote"

# ============================================================ leg 4: the publishable shape
step "leg 4/4: the release shape carries its own sources"

REL="$WORK/release"
mkdir -p "$REL"
write_fast_widget "$REL/fast-widget"
write_host "$REL/app" app yes
write_declaration "$REL/app"

"$NICHLINK" check "$REL/app" >/dev/null || fail "the release host does not check"
"$NICHLINK" crates --release --write "$REL/app" >/dev/null || fail "the release shape does not write"

# The fragment brings its own files, the ancestor faces its derivation reads, and its declaration.
# 碎片带来自己的文件、推导要读的祖先面，以及它的声明。
for file in \
  "$REL/crates/app-widgets/src/panel/frame/frame.rs" \
  "$REL/crates/app-widgets/src/panel/frame/widget/widget.rs" \
  "$REL/crates/app-widgets/src/panel/frame/registry_rule/registry_rule.rs" \
  "$REL/crates/app-widgets/src/panel/panel.rs" \
  "$REL/crates/app-widgets/add_crates.rs"; do
  [ -f "$file" ] || fail "the release ghost does not carry $file"
done
grep -q 'shape = "release"' "$REL/crates/app-widgets/Cargo.toml" || fail "no shape fingerprint"
# Nothing is mounted out of the host, and nothing needs a remap.
if grep -q "$REL/app/src" "$REL/crates/app-widgets/build.rs"; then
  fail "the release build script names the host's source directory"
fi
[ ! -f "$REL/.cargo/config.toml" ] ||
  fail "the release shape wrote a remap config it does not need"

step "leg 4: building the release shape, and packaging it"
(cd "$REL/crates/app-facade" && build) || fail "the release shape does not build"
# `cargo package --list` is the check that the package is self-contained: a file it needs but does not
# carry is exactly the state crates.io rejects later.
(cd "$REL/crates/app-widgets" && command cargo package --list $CARGO_FLAGS --allow-dirty >/dev/null 2>&1) ||
  fail "the release ghost cannot be packaged"
[ -z "$(find "$REL" -name config.toml -path '*/.cargo/*' 2>/dev/null)" ] ||
  fail "the release shape left a remap config behind"

"$NICHLINK" crates --revert "$REL/app" >/dev/null || fail "the release shape does not revert"
[ ! -d "$REL/crates/app-widgets" ] || fail "the revert left the release ghost behind"

step "leg 5: the committed example (examples/partitioned-button) still builds and still carries its graft"

# The four legs above build fixtures the script itself writes, so nothing in the repository *is* a
# partitioned host. This leg is the one that keeps a real one alive: a committed example carrying
# `add_crates.rs`, its two generated packages, and a graft whose cuts moved into the crate the split
# created. If a change ever breaks the shape, this fails where a reader can see it.
# 上面四条腿构建的都是脚本自己写出来的夹具，因此仓库里没有一棵**真的**被划分过的宿主。这条腿守住那个真的：
# 一个入库的示例，带 `add_crates.rs`、它那两个生成包，以及一次"切口随边界搬进新 crate"的 graft。以后谁把这条路
# 走坏了，它会在这里红，而不是等读者自己撞上。
EXAMPLE="$ROOT/examples/partitioned-button"
[ -f "$EXAMPLE/host/add_crates.rs" ] || fail "the committed example lost its declaration"
(cd "$EXAMPLE" && build --workspace) || fail "the committed example does not build"
# The committed example is the **release** shape, and that changes who emits the cuts: a release
# ghost builds its **own** manifest (it carries copies, so it never reads the host's entry, and the
# host's graft plan lives there) ⇒ the ghost emits none, and the **facade** carries the union with the
# owner rewritten. In the development shape the ghost emits its own two — the difference is
# self-containment, not a rule about faces.
# 入库示例用的是**发布**形状，而它改变了"谁发切口"：发布幽灵构建的是**它自己的**清单（它携带副本，
# 因此从不读宿主的入口，而宿主的 graft 计划住在那里）⇒ 幽灵一条都不发，由 **facade** 携带并集并改写属主。
# 开发形状下幽灵会发自己那两条——差别来自自包含，而不是"面归谁"的规则变了。
cuts_in() {
  # The **newest** file, because a build directory survives a change of shape: an artifact from
  # before the declaration existed still sits there and would answer for the old tree. And the count
  # goes through `$( )` rather than `grep -c || printf 0`: `grep -c` prints `0` *and* exits 1, so the
  # `||` used to print a second `0` and the comparison read `"00"` (measured — this leg failed on it).
  # 取**最新**的那份：构建目录会在形状改变后留下来，声明存在之前的那份产物还在，会替旧树作答。计数经 `$( )`
  # 取，而不是 `grep -c || printf 0`：`grep -c` 会**打印** `0` **并**以 1 退出，于是 `||` 又打一个 `0`，
  # 比较读到的是 `"00"`（实测：这条腿就是被它判红的）。
  file=$(ls -t $(find "$EXAMPLE/target" -path "*/$1-*/out/generated_lib.rs" 2>/dev/null) 2>/dev/null | head -1)
  [ -n "$file" ] || { printf 'missing'; return; }
  printf '%s' "$(grep -c 'StaticGraftCut::from_ids' "$file" 2>/dev/null)"
}
[ "$(cuts_in nichlink-example-partitioned-button)" = "0" ] ||
  fail "the partitioned host still emits graft cuts for faces it does not compile"
[ "$(cuts_in partitioned-button-objects)" = "0" ] ||
  fail "the release ghost emits cuts, but it builds its own manifest and carries no host plan"
[ "$(cuts_in partitioned-button-facade)" = "2" ] ||
  fail "the facade does not carry the union — nothing else in the release shape does"
facade_file=$(find "$EXAMPLE/target" -path "*/partitioned-button-facade-*/out/generated_lib.rs" 2>/dev/null | head -1)
grep -q 'partitioned_button_objects::control::object::button::NODE_ID' "$facade_file" ||
  fail "the facade does not name the crate that compiles the cut face"

# ============================================================ leg 6: re-partitioning
step "leg 6/6: the same graft plan under two different crate boundaries"

# The property this leg gates is the reason cross-crate grafts exist: 「跨crate graft是为了防止后续crate调整
# 导致的graft失效」. So the author's plan is written **once**, the boundary under it moves, and after every
# move all three crates build with the *same* cut, carrying the *same* identities. The tree is one level
# deeper than leg 1's so the boundary can move without ever claiming a leaf: a leaf has no `SUBTREE`
# marker, so it is not a crate — that refusal is the compiler's, and this leg never trips it.
# 这条腿守的性质正是跨 crate graft 存在的理由：「跨crate graft是为了防止后续crate调整导致的graft失效」。
# 因此作者的 plan 只写**一次**，它下面的边界搬来搬去，而每一次搬完之后三个 crate 都用**同一条**切口、带
# **同样的**身份构建得过。这棵树比 leg 1 那棵深一层，好让边界在"从不认领叶子"的前提下移动：叶子没有
# `SUBTREE` 标记，因此不是一个 crate——那条拒绝是编译器的，本腿从不触发它。
write_repartition_host() {
  mkdir -p "$1/src/panel/frame/widget/cap" "$1/src/panel/frame/widget/registry_rule" \
    "$1/src/panel/frame/registry_rule" "$1/src/panel/registry_rule"
  cat >"$1/Cargo.toml" <<EOF
[package]
name = "$2"
version = "0.1.0"
edition = "2024"

[dependencies]
nichlink-toolchain = { path = "$ROOT/toolchain", features = ["run"] }
fast-widget = { path = "../fast-widget" }

[build-dependencies]
nichlink-toolchain = { path = "$ROOT/toolchain", features = ["build"] }
EOF
  cat >"$1/build.rs" <<'EOF'
fn main() {
    println!("cargo:rerun-if-changed=src");
    nichlink_toolchain::build_method::run();
}
EOF
  # The plan the boundary is about to move under. It is written once here and never touched again: the
  # sha256 of this file is compared after every re-partition, and a leg that let `crates --write` rewrite
  # the author's plan would fail there instead of silently passing.
  # 边界即将在它下面搬动的 plan。它在这里写一次、之后再也不动：每次重新划分之后都比较这个文件的 sha256，
  # 因此"`crates --write` 把作者的 plan 改写了"的腿会在那里红，而不是悄悄通过。
  cat >"$1/src/lib.rs" <<'EOF'
nichlink_toolchain::run_method::host!();

pub const FRAMEWORK: FrameworkId = FrameworkId::new("nichlink.rehearsal.repartition");

nichlink_toolchain::run_method::static_graft_plan!(
    FRAMEWORK,
    cut(crate::panel::frame::widget::cap::NODE_ID) graft(fast_widget::fast::NODE_ID),
);
EOF
  cat >"$1/src/panel/panel.rs" <<'EOF'
crate::root_object! {
    kind: Panel,
    needs_registry: true,
    parent: crate::root_node_id(crate::NICHLINK_NAMESPACE),
}
EOF
  cat >"$1/src/panel/registry_rule/registry_rule.rs" <<'EOF'
//! Panel 对直接子对象的最低结构要求。
//! Panel's minimum structure for a direct child.

use crate::RegistrationRule;

pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new();
EOF
  cat >"$1/src/panel/frame/frame.rs" <<'EOF'
crate::panel_object! {
    kind: Frame,
    needs_registry: true,
    parent: crate::panel::NODE_ID,
}
EOF
  cat >"$1/src/panel/frame/registry_rule/registry_rule.rs" <<'EOF'
//! Frame 对直接子对象的最低结构要求。
//! Frame's minimum structure for a direct child.

use crate::RegistrationRule;

pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new();
EOF
  cat >"$1/src/panel/frame/widget/widget.rs" <<'EOF'
crate::frame_object! {
    kind: Widget,
    needs_registry: true,
    parent: crate::panel::frame::NODE_ID,
}
EOF
  cat >"$1/src/panel/frame/widget/registry_rule/registry_rule.rs" <<'EOF'
//! Widget 对直接子对象的最低结构要求。
//! Widget's minimum structure for a direct child.

use crate::RegistrationRule;

pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new();
EOF
  # The cut face: a leaf, and the only thing in the subtree that carries no registry of its own.
  # 切口面：叶子，也是这棵子树里唯一不拥有注册机的东西。
  cat >"$1/src/panel/frame/widget/cap/cap.rs" <<'EOF'
crate::widget_object! {
    kind: Cap,
    parent: crate::panel::frame::widget::NODE_ID,
}
EOF
  # A **second** branch, so one crate can be asked to claim two subtrees (the B-axis gap: nothing
  # end-to-end proved that `Crate::named(..).at(&[a::SUBTREE, b::SUBTREE])` materializes both).
  # **第二条**分支，好让同一个 crate 被要求认领两棵子树（B 轴缺口：`Crate::named(..).at(&[a::SUBTREE,
  # b::SUBTREE])` 会把两棵都物化出来，这件事此前没有端到端证据）。
  mkdir -p "$1/src/panel/gauge/needle" "$1/src/panel/gauge/registry_rule"
  cat >"$1/src/panel/gauge/gauge.rs" <<'EOF'
crate::panel_object! {
    kind: Gauge,
    needs_registry: true,
    parent: crate::panel::NODE_ID,
}
EOF
  cat >"$1/src/panel/gauge/registry_rule/registry_rule.rs" <<'EOF'
//! Gauge 对直接子对象的最低结构要求。
//! Gauge's minimum structure for a direct child.

use crate::RegistrationRule;

pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new();
EOF
  cat >"$1/src/panel/gauge/needle/needle.rs" <<'EOF'
crate::gauge_object! {
    kind: Needle,
    parent: crate::panel::gauge::NODE_ID,
}
EOF
}

# The declaration that fixes one boundary: `$2` is the subtree expression the crate claims.
# 固定某一条边界的声明：`$2` 是这个 crate 认领的子树表达式。
write_boundary() {
  cat >"$1/add_crates.rs" <<EOF
//! The crate shape this hosted tree declares.
//! 这棵宿主树声明的 crate 形状。

use nichlink_toolchain::run_method::{Crate, Shape};

pub fn add_crates() -> Shape {
    Shape::of("app", &[Crate::named("widgets").at(&[$2])])
}
EOF
}

# One graft entry of a generated tree, verbatim — the cut, the graft and the `full` flag together.
# 一棵生成树里的某条 graft 条目，逐字——切口、替换与 `full` 标志合在一起。
cut_entry() {
  grep -o 'StaticGraftCut::from_ids([^;]*),' "$1/generated_lib.rs" | head -1
}

# How many graft entries a generated tree carries. `$( )` around `grep -c`, never `grep -c || printf 0`
# — `grep -c` prints `0` *and* exits 1, which is how leg 5 once compared `"00"`.
# 一棵生成树带几条 graft 条目。`grep -c` 外面套 `$( )`，绝不用 `grep -c || printf 0`——`grep -c` 会**打印**
# `0` **并**以 1 退出，leg 5 就是这样比出 `"00"` 的。
cut_count() {
  [ -f "$1/generated_lib.rs" ] || { printf 'missing'; return; }
  printf '%s' "$(grep -c 'StaticGraftCut::from_ids' "$1/generated_lib.rs" || true)"
}

RP="$WORK/repartition"
mkdir -p "$RP"
cat >"$RP/Cargo.toml" <<'EOF'
[workspace]
resolver = "3"
members = [
    "app",
    "fast-widget",
]
EOF
write_fast_widget "$RP/fast-widget"
write_repartition_host "$RP/app" app

step "leg 6: the unpartitioned baseline — the plan lands in the host"
"$NICHLINK" check "$RP/app" >/dev/null || fail "the two-level host does not check"
cp -R "$RP/app/target/nichlink/out" "$WORK/rp-base"
(cd "$RP" && build -p app) || fail "the unpartitioned two-level host does not build"
cp "$RP/app/src/lib.rs" "$WORK/rp-lib-before"
BASELINE_CUT=$(cut_entry "$WORK/rp-base")
[ -n "$BASELINE_CUT" ] || fail "the baseline host emits no typed graft cut at all"

# One boundary: check every shape, write it, build it, and compare the cut against the baseline.
# 一条边界：把每个形状都 check 一遍、写出来、构建，并把切口与基准逐字比较。
repartition() {
  label=$1
  only=$2
  claim=$3
  second_claim_file=${4:-}
  write_boundary "$RP/app" "$claim"
  "$NICHLINK" check "$RP/app" >/dev/null ||
    fail "leg 6/$label: the host does not check after the boundary moved"
  cp -R "$RP/app/target/nichlink/out" "$WORK/rp-$label-host"
  NICH_LINK_SHAPE_ONLY="$only" "$NICHLINK" check "$RP/app" >/dev/null ||
    fail "leg 6/$label: the ghost shape does not check"
  cp -R "$RP/app/target/nichlink/out" "$WORK/rp-$label-ghost"
  NICH_LINK_SHAPE_FACADE=1 "$NICHLINK" check "$RP/app" >/dev/null ||
    fail "leg 6/$label: the facade shape does not check"
  cp -R "$RP/app/target/nichlink/out" "$WORK/rp-$label-facade"

  [ "$(cut_count "$WORK/rp-$label-host")" = "0" ] ||
    fail "leg 6/$label: the host still emits a cut for a face it does not compile"
  [ "$(cut_count "$WORK/rp-$label-ghost")" = "1" ] ||
    fail "leg 6/$label: the ghost does not emit the one cut it compiles"
  [ "$(cut_count "$WORK/rp-$label-facade")" = "1" ] ||
    fail "leg 6/$label: the facade does not carry the cut"
  [ "$(cut_entry "$WORK/rp-$label-ghost")" = "$BASELINE_CUT" ] ||
    fail "leg 6/$label: the cut changed when the boundary moved (identity or graft differ)"
  grep -q 'app_widgets::panel::frame::widget::cap::NODE_ID' "$WORK/rp-$label-facade/generated_lib.rs" ||
    fail "leg 6/$label: the facade does not name the crate that compiles the cut face"
  cmp "$WORK/rp-lib-before" "$RP/app/src/lib.rs" ||
    fail "leg 6/$label: re-partitioning rewrote the author's graft plan"
  # A second claim is only real if the ghost that owns it actually mounts the files below it — the
  # claim being accepted in the declaration is not evidence that anything was materialized.
  # 第二条认领只有在真正拥有它的幽灵确实挂载了它下面的文件时才算数——声明收下了那条认领，并不证明有任何
  # 东西被物化出来。
  if [ -n "$second_claim_file" ]; then
    grep -q "$second_claim_file" "$WORK/rp-$label-ghost/generated_lib.rs" ||
      fail "leg 6/$label: the ghost does not mount $second_claim_file — the second claim was not materialized"
  fi

  "$NICHLINK" crates --write "$RP/app" >/dev/null || fail "leg 6/$label: the boundary does not write"
  (cd "$RP" && build -p app-facade) || fail "leg 6/$label: the re-partitioned workspace does not build"
}

# The boundary starts one level **below** the root face and then moves up, so the same plan is compiled
# by a different crate without the author touching a line of it. The second move also re-writes on top of
# the first boundary, which is what a user editing the declaration and running `--write` again does.
# 边界先落在根面**下面**一层，然后往上搬，于是同一份 plan 由另一个 crate 编译，而作者一行都没动。第二次
# 搬动还是在第一条边界之上重写——这正是"用户改了声明再跑一次 `--write`"所做的事。
step "leg 6: boundary A — the subtree below the root face"
repartition a-widget panel::frame::widget "crate::panel::frame::widget::SUBTREE"
step "leg 6: boundary B — one level up, the same plan"
repartition b-frame panel::frame "crate::panel::frame::SUBTREE"
# Two claims by **one** crate: the declared `Crate` names both subtrees, and both have to be compiled by
# the same ghost, mounted from the host, and built together — the end-to-end leg the matrix was missing.
# **一个** crate 认领两棵子树：声明的 `Crate` 点名两棵，两棵都必须由同一个幽灵编译、从宿主挂载、并一起
# 构建——这正是矩阵此前缺的那条端到端。
step "leg 6: boundary C — one crate claiming two subtrees"
repartition c-two-claims "panel::frame::widget,panel::gauge" \
  "crate::panel::frame::widget::SUBTREE, crate::panel::gauge::SUBTREE" \
  "panel/gauge/needle/needle.rs"

step "OK — both shapes build, the four facts hold, the promote lands, the release shape packages, the committed example still carries its graft, and the same plan survives two crate boundaries"
