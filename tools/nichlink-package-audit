#!/bin/sh
set -eu

# Local package audit for the nine publishable crates.
# 九个待发布 crate 的本地打包审计。
#
# The audit has two halves, and only one of them waits for the first publish.
# 审计有两半，只有一半需要等首次发布。
#
# Contents are checked for all nine crates today. `cargo package --list` needs no
# registry, so every source module under a crate's `src/` and the README its
# manifest declares must appear in the package or the audit fails. This matters
# more here than in most workspaces: modules are mounted with
# `#[path = "..."]`, so a file cargo did not pick up is a crate that does not
# compile for anyone, and it would compile fine locally where the file exists.
# 内容检查今天对九个 crate 全部生效。`cargo package --list` 不需要 registry，因此每个
# crate `src/` 下的每个源码模块、以及清单声明的 README 都必须出现在包里，否则审计失败。
# 这在本工作区比在多数工作区更重要：模块是用 `#[path = "..."]` 挂载的，因此 cargo 没收进去
# 的文件等于一个对任何人都编译不过的 crate，而在文件存在的本地它编译得好好的。
#
# A crate can only be *packaged* (built from the tarball in isolation, which is
# what `cargo package` verifies) once every versioned `nichlink-*` dependency it
# names is resolvable on the target registry. Before the first publish those
# dependencies are absent, so this script warns about the affected crate and
# skips that half, then exits 0. Every crate whose dependencies are already
# published is still checked in full: core is checked from today, and the rest
# start being checked automatically as they land on crates.io. A packaging
# failure in a checkable crate is a real error and makes the script exit
# non-zero; the CI step that calls it no longer sets continue-on-error.
# 只有当某个 crate 写下的每个带版本号的 `nichlink-*` 依赖都能在目标 registry 上解析
# 时，它才能被打包（从 tarball 隔离构建，也就是 `cargo package` 所校验的事）。首次发布
# 之前这些依赖都不存在，因此脚本会警告受影响的 crate、跳过这一半，然后以 0 退出。依赖
# 已经发布的 crate 仍会被完整检查：core 从今天起就被检查，其余 crate 上线后自动开始被
# 检查。可检查的 crate 若打包失败就是真实错误，脚本以非零退出——调用它的 CI 步骤已不再
# 设置 continue-on-error。
#
# The order below mirrors docs/roadmap-1.0.md decision 1:
#   core -> macro / build_method / mcp -> run_method -> debug_method /
#   plugin-host -> studio -> cli
# 下面的顺序与 docs/roadmap-1.0.md 决策 1 一致。
#
# Each entry is "<crate>:<directory>:<comma-separated versioned nichlink-* deps>".
# The directory is spelled out rather than derived because the mapping is not a
# rule: `nichlink-build-method` lives in `build_method/` while
# `nichlink-plugin-host` lives in `plugin-host/`. Dependencies are comma
# separated, not space separated: the entries are read by `for entry in $crates`,
# so a space inside one would split it into several and silently evaluate a crate
# with only its first dependency.
# 每项形如 "<crate>:<目录>:<以逗号分隔的带版本号 nichlink-* 依赖>"。目录是写出来的而不是
# 推导的，因为映射不是一条规则：`nichlink-build-method` 在 `build_method/`，而
# `nichlink-plugin-host` 在 `plugin-host/`。依赖用逗号而不是空格分隔：这些项由
# `for entry in $crates` 读取，项内的空格会把它拆成多项，并静默地只按第一个依赖去评估
# 一个 crate。

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

index_url="https://index.crates.io"

# The version every internal dependency requires (caret `0.1.0`), read from
# `[workspace.package]` and nowhere else: a `version = "…"` line elsewhere in the root
# manifest (a centralized dependency requirement, say) is not the release version, and
# reading the first matching line made a stale one look like the release.
# 所有内部依赖要求的版本（caret `0.1.0`），只从 `[workspace.package]` 读取：根清单其他位置的
# `version = "…"`（比如集中写的依赖要求）不是发布版本，而读第一处匹配会让一行陈旧的版本看起来像
# 发布版本。
workspace_version=$(awk '
  /^\[/ { section = $0; next }
  section == "[workspace.package]" && /^version *=/ {
    value = $0
    sub(/^version *= *"/, "", value)
    sub(/"$/, "", value)
    print value
    exit
  }
' Cargo.toml)
if [ -z "$workspace_version" ]; then
  echo "error: [workspace.package] names no version in Cargo.toml" >&2
  exit 1
fi

# Package dependencies and the declared readme/license-file come from `cargo
# metadata --no-deps`, not from a scan of the TOML. Three spellings the scan
# missed are ordinary manifest syntax: a dotted `[dependencies.nichlink-x]`
# table, a target-specific `[target.'cfg(…)'.dependencies]` table, and an
# inherited `readme.workspace = true` / `license-file.workspace = true`. The
# scan disagreed with `tools/nichlink-publish --check-table` about the first two
# and silently skipped the readme check for the third, so a crate whose declared
# readme was not the one it packaged could still be reported as contents-checked.
# `--no-deps` keeps the call offline: it asks only about the workspace members,
# so no registry is consulted and a cold CI cache behaves like a warm local one.
# 包的依赖与清单声明的 readme/license-file 改从 `cargo metadata --no-deps` 读取，而不是
# 扫描 TOML。扫描漏掉的三种拼法都是普通清单语法：点表 `[dependencies.nichlink-x]`、按目标
# 限定的 `[target.'cfg(…)'.dependencies]` 表，以及继承的 `readme.workspace = true` /
# `license-file.workspace = true`。扫描在前两者上与 `tools/nichlink-publish --check-table`
# 不一致，在第三者上则静默跳过 readme 检查，因此一个声明的 readme 与实际打包不符的 crate 仍
# 可能被报成内容已检查。`--no-deps` 让这次调用保持离线：它只问工作区成员，因此不查 registry，
# 冷启动的 CI 缓存与本地热缓存行为一致。
metadata_json=$(cargo metadata --no-deps --format-version 1 2>/dev/null) || {
  echo "error: cargo metadata --no-deps failed; cannot derive package dependencies" >&2
  exit 1
}

# One field ("deps", "readme" or "license_file") of one workspace package, from
# the metadata snapshot above. The compact JSON is split at every `{"name":"`
# object boundary: a piece that names a `path+file` id is a package header, a
# piece that carries `"source":…,"req":…,"kind":…` is one of that package's
# dependencies, and the piece after a package's last dependency still carries
# that package's trailing `readme`/`license_file`. This is deliberately not a
# JSON parser: a real one would be a fourth thing to keep in step with Cargo,
# and every field read here is one Cargo writes unconditionally.
# 上面元数据快照里某个工作区包的一个字段（"deps"、"readme" 或 "license_file"）。紧凑 JSON
# 在每个 `{"name":"` 对象边界切开：带 `path+file` id 的片段是包首部，带
# `"source":…,"req":…,"kind":…` 的片段是该包的一个依赖，而某个包最后一个依赖之后的片段仍
# 带着该包尾部的 `readme`/`license_file`。这里刻意不写成 JSON 解析器：真正的解析器会成为第四件
# 要与 Cargo 保持同步的东西，而这里读到的每个字段都是 Cargo 无条件写出的。
metadata_field() {
  crate=$1
  field=$2
  printf '%s\n' "$metadata_json" | awk -v crate="$crate" -v field="$field" '
    function package_start(p) {
      return p ~ /^[^"]*","version":"[^"]*","id":"path[+]file/
    }
    function is_dependency(p) {
      return p ~ /^[^"]*","source":[^,]*,"req":"[^"]*","kind":/
    }
    function name_of(p,   s) {
      s = p
      sub(/".*$/, "", s)
      return s
    }
    function readme_of(p,   s, v, out) {
      out = ""
      s = p
      while (match(s, /"readme":("[^"]*"|null)/)) {
        v = substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
        if (v ~ /^"readme":"/) {
          sub(/^"readme":"/, "", v)
          sub(/"$/, "", v)
          out = v
        }
      }
      return out
    }
    function license_of(p,   v) {
      if (match(p, /"license_file":("[^"]*"|null)/)) {
        v = substr(p, RSTART, RLENGTH)
        if (v ~ /^"license_file":"/) {
          sub(/^"license_file":"/, "", v)
          sub(/"$/, "", v)
          return v
        }
      }
      return ""
    }
    function emit() {
      if (current != crate) return
      if (field == "readme" && readme != "") print readme
      if (field == "license_file" && license != "") print license
    }
    {
      line = $0
      gsub(/[{]"name":"/, "\n", line)
      n = split(line, piece, "\n")
      current = ""
      readme = ""
      license = ""
      for (i = 1; i <= n; i++) {
        p = piece[i]
        if (package_start(p)) {
          emit()
          current = name_of(p)
          readme = readme_of(p)
          license = license_of(p)
        }
        if (current != crate) continue
        if (field == "deps") {
          if (is_dependency(p)) {
            kind = ""
            if (match(p, /","source":[^,]*,"req":"[^"]*","kind":("[a-z]*"|null),/)) {
              kind = substr(p, RSTART, RLENGTH)
              sub(/^.*"kind":/, "", kind)
              sub(/,$/, "", kind)
              gsub(/"/, "", kind)
            }
            d = name_of(p)
            if (kind != "dev" && d ~ /^nichlink-/) print d
          }
        } else if (field == "readme") {
          r = readme_of(p)
          if (r != "") readme = r
        } else if (field == "license_file") {
          l = license_of(p)
          if (l != "") license = l
        }
      }
      emit()
    }
  '
}

# The shipped crates are derived from the workspace, not listed: a hand-kept table
# is one a new member can simply not appear in. The audit added a tenth published
# member and this tool still reported "all nine crates" while
# `tools/nichlink-publish --check-table` caught it — the derivation below is the
# same one, duplicated for the same reason the index probe is: each tool has to stay
# runnable on its own.
# 已发布的 crate 从工作区推导，而不是手列：手工表正是新成员可以干脆不出现的那种表。审计加了
# 第十个已发布成员，而本工具仍报"all nine crates"，反倒是 `tools/nichlink-publish --check-table`
# 抓到了它——下面这段推导与它相同，复刻的理由与 index 探针一样：每个工具都必须能独立运行。
members=$(awk '
  /^members *= *\[/ { inside = 1 }
  inside {
    line = $0
    sub(/^[^[]*\[/, "", line)
    sub(/\].*$/, "", line)
    gsub(/[",]/, "", line)
    count = split(line, parts, / +/)
    for (i = 1; i <= count; i++) if (parts[i] != "") print parts[i]
    if ($0 ~ /\]/) exit
  }
' Cargo.toml)

crates=""
crate_count=0
for member in $members; do
  manifest="$member/Cargo.toml"
  [ -f "$manifest" ] || continue
  # A member that does not publish is not a package to audit.
  # 不发布的成员不是要审计的包。
  if grep -qE '^publish *= *false' "$manifest"; then
    continue
  fi
  name=$(sed -n 's/^name = "\(.*\)"/\1/p' "$manifest" | head -n 1)
  [ -n "$name" ] || continue
  # Internal dependencies (normal and build kinds, target-specific ones
  # included, dev-dependencies excluded because they never ship), resolved by
  # Cargo rather than read out of the manifest.
  # 内部依赖（normal 与 build 两种 kind，含按目标限定的，排除永不出厂的
  # dev-dependencies），由 Cargo 解析，而不是从清单里读出。
  deps=$(metadata_field "$name" deps | sort -u | tr '\n' ',')
  deps=${deps%,}
  crates="$crates
$name:$member:$deps"
  crate_count=$((crate_count + 1))
done

if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
  echo "warn: neither curl nor wget is available; the index probe cannot run," \
    "so the audit will stop rather than report crates as unpublished" >&2
fi

# Sparse-index path for a crate name: 1/<n>, 2/<n>, 3/<c>/<n>, else
# <first two>/<next two>/<n>.
# crate 名的 sparse index 路径：1/<n>、2/<n>、3/<c>/<n>，其余为
# <前两个字符>/<后两个字符>/<n>。
index_path() {
  name=$1
  length=${#name}
  if [ "$length" -eq 1 ]; then
    printf '1/%s' "$name"
  elif [ "$length" -eq 2 ]; then
    printf '2/%s' "$name"
  elif [ "$length" -eq 3 ]; then
    printf '3/%s/%s' "$(printf '%s' "$name" | cut -c1)" "$name"
  else
    printf '%s/%s/%s' \
      "$(printf '%s' "$name" | cut -c1-2)" \
      "$(printf '%s' "$name" | cut -c3-4)" \
      "$name"
  fi
}

# The index serves one JSON object per published version, so an exact version
# match is the publication test, and the matched object must also say
# `"yanked":false`: a yanked version is still served by the index but can no
# longer be resolved by a new dependent, so counting it as published reported a
# crate as checkable that no consumer could actually use.
# index 为每个已发布版本提供一行 JSON，因此精确匹配版本号就是发布判定，且匹配到的对象还必须
# 写着 `"yanked":false`：被撤回的版本仍由 index 提供，但新的依赖方已无法解析它，因此把它算作
# 已发布会把一个没有消费者用得上的 crate 报成可检查。
#
# The request is retried before "not published" is believed. A transient failure
# used to be indistinguishable from an absent version, and the two runs that
# followed the first publish disagreed about which crates were checkable for
# exactly that reason: the same tree reported `skipped` for a crate published an
# hour earlier, then `failed` for one whose dependency the verify build fetched
# from a half-propagated index. A claim about the registry has to survive the
# registry being briefly unreachable.
# 在相信"未发布"之前会重试。过去，瞬时失败与版本不存在无法区分，而首次发布之后的相邻两次运行
# 对"哪些 crate 可检查"给出了不同答案，原因正是这个：同一棵树上，一小时前就发布的 crate 被报成
# `skipped`，随后又有一个 crate 因为校验构建从只传播了一半的 index 取依赖而被报成 `failed`。
# 关于 registry 的断言必须能经受"registry 短暂不可达"。
#
# A failure that outlives the retries is not an answer from the registry, so it
# is reported and exits non-zero here instead of turning into "not published":
# against a dead endpoint the audit used to report `verified: 1, skipped: 8` and
# exit 0. HTTP 404 keeps its meaning — the sparse index serves one file per
# crate, so a missing file is a real "no versions published" — and only that
# status is treated as the registry's answer.
# 熬过重试的失败不是 registry 给出的答案，因此这里会报出它并以非零退出，而不是把它变成
# "未发布"：面对一个死端点时，审计过去会报 `verified: 1, skipped: 8` 并以 0 退出。HTTP 404
# 保持原意——sparse index 每个 crate 一个文件，文件缺失就是真实的"没有发布过版本"——且只有
# 该状态被当作 registry 的答案。
is_published() {
  name=$1
  version=$2
  path=$(index_path "$name")
  status=0
  if command -v curl >/dev/null 2>&1; then
    body=$(curl -fsS --max-time 20 --retry 3 --retry-connrefused --retry-delay 2 \
      "$index_url/$path" 2>/dev/null) || status=$?
    # curl exit 22 is "HTTP page not retrieved": the server answered with a
    # 4xx/5xx status. `--retry` already retried the 5xx statuses, so what
    # survives to here is the 404 that means "no such crate file"; every other
    # exit code is the request itself failing.
    # curl 退出码 22 是"未能取得 HTTP 页面"：服务端以 4xx/5xx 作答。`--retry` 已经重试过
    # 5xx，因此留到这里的是表示"没有该 crate 文件"的 404；其他退出码都是请求本身失败。
    if [ "$status" -ne 0 ] && [ "$status" -ne 22 ]; then
      printf 'error: cannot reach the index at %s (curl exit %s); refusing to report crates as unpublished from an unreachable registry\n' \
        "$index_url" "$status" >&2
      exit 1
    fi
  elif command -v wget >/dev/null 2>&1; then
    body=$(wget -q -O - --timeout=20 --tries=3 --waitretry=2 "$index_url/$path" 2>/dev/null) || status=$?
    # wget exit 8 is "server issued an error response" (the 404 above); every
    # other code is a network-level failure.
    # wget 退出码 8 是"服务端返回了错误响应"（即上面的 404）；其余都是网络层失败。
    if [ "$status" -ne 0 ] && [ "$status" -ne 8 ]; then
      printf 'error: cannot reach the index at %s (wget exit %s); refusing to report crates as unpublished from an unreachable registry\n' \
        "$index_url" "$status" >&2
      exit 1
    fi
  else
    printf 'error: neither curl nor wget is available; cannot probe the index at %s\n' "$index_url" >&2
    exit 1
  fi
  if [ "$status" -ne 0 ]; then
    return 1
  fi
  # One JSON object per version per line, so the second match tests the same
  # version's object rather than any object in the crate's file.
  # 每个版本每行一个 JSON 对象，因此第二次匹配检查的是同一个版本对象，而不是该 crate 文件里
  # 任意一个对象。
  printf '%s\n' "$body" |
    grep -F "\"vers\":\"$version\"" |
    grep -F '"yanked":false' >/dev/null 2>&1
}

# Every source module and the declared readme/license-file must be in the
# package. Runs for every crate, published or not, because the listing needs no
# registry.
# 每个源码模块与清单声明的 readme/license-file 都必须在包里。对每个 crate 都运行，无论是否
# 已发布，因为列清单不需要 registry。
check_contents() {
  crate=$1
  directory=$2
  readme=$3
  license_file=$4
  if ! listing=$(cargo package --list -p "$crate" --locked --allow-dirty 2>/dev/null); then
    printf 'error: cargo package --list failed for %s:\n' "$crate" >&2
    cargo package --list -p "$crate" --locked --allow-dirty >&2 || true
    return 1
  fi
  status=0
  modules=$(find "$directory/src" -name '*.rs' | sort)
  for module in $modules; do
    relative=${module#"$directory"/}
    if ! printf '%s\n' "$listing" | grep -Fx "$relative" >/dev/null; then
      printf 'error: %s does not package %s\n' "$crate" "$relative" >&2
      status=1
    fi
  done
  # A declared file cargo copies in from outside the package (the
  # `readme.workspace = true` / `license-file.workspace = true` inherited from
  # the workspace root) is reported by `cargo metadata` relative to the member as
  # `../README.md`, while `cargo package --list` names the copy at the package
  # root `README.md`. Either spelling satisfies the check; its point is that the
  # declared file reaches the package.
  # 由 cargo 从包外复制进来的声明文件（从工作区根继承的 `readme.workspace = true` /
  # `license-file.workspace = true`）在 `cargo metadata` 里相对成员报成 `../README.md`，
  # 而 `cargo package --list` 把它在包根的副本命名为 `README.md`。两种拼法都满足检查；检查的
  # 要点是声明的文件确实进了包。
  if [ -n "$readme" ] &&
    ! printf '%s\n' "$listing" | grep -Fx "$readme" >/dev/null &&
    ! printf '%s\n' "$listing" | grep -Fx "${readme##*/}" >/dev/null; then
    printf 'error: %s does not package its declared readme %s\n' "$crate" "$readme" >&2
    status=1
  fi
  if [ -n "$license_file" ] &&
    ! printf '%s\n' "$listing" | grep -Fx "$license_file" >/dev/null &&
    ! printf '%s\n' "$listing" | grep -Fx "${license_file##*/}" >/dev/null; then
    printf 'error: %s does not package its declared license file %s\n' "$crate" "$license_file" >&2
    status=1
  fi
  return $status
}

verified=""
skipped=""
failed=""
content_failed=""

for entry in $crates; do
  crate=${entry%%:*}
  rest=${entry#*:}
  directory=${rest%%:*}
  deps=${rest#*:}

  printf 'checking contents of %s\n' "$crate"
  if check_contents "$crate" "$directory" \
    "$(metadata_field "$crate" readme)" "$(metadata_field "$crate" license_file)"; then
    :
  else
    content_failed="$content_failed $crate"
  fi

  missing=""
  for dep in $(printf '%s' "$deps" | tr ',' ' '); do
    if ! is_published "$dep" "$workspace_version"; then
      missing="$missing $dep"
    fi
  done
  if [ -n "$missing" ]; then
    printf 'warn: skipping packaging %s: versioned dependency not on %s yet:%s\n' \
      "$crate" "$index_url" "$missing" >&2
    skipped="$skipped $crate"
    continue
  fi
  printf 'checking package of %s\n' "$crate"
  if cargo package -p "$crate" --locked --allow-dirty; then
    verified="$verified $crate"
  else
    printf 'error: cargo package failed for %s\n' "$crate" >&2
    failed="$failed $crate"
  fi
done

cat <<EOF
Package audit summary
  contents checked: all $crate_count shipped crates
  contents failed:${content_failed:- none}
  verified:${verified:- none}
  skipped:${skipped:- none}
  failed:${failed:- none}
Contents are checked for every crate from today. Skipped crates have a
versioned nichlink-* dependency that is not on $index_url yet; they become
checkable automatically once that dependency is published. See
docs/roadmap-1.0.md decision 1 for the publish order.
内容检查从今天起对每个 crate 生效。跳过的 crate 有尚未发布到 $index_url 的
nichlink-* 版本依赖；该依赖发布后它们会自动变为可检查。发布顺序见
docs/roadmap-1.0.md 决策 1。
EOF

if [ -n "$content_failed" ]; then
  echo "one or more packages are missing files they need" >&2
  exit 1
fi
if [ -n "$failed" ]; then
  echo "one or more checkable packages failed" >&2
  exit 1
fi
exit 0
