SCORING_RULES = """\
Scoring rules (mechanical; no model is a judge) / 判分规则（机械；不许模型当裁判）

`.audit/truth.json` is written by `build` from the injection itself, never from an answer.
  root_cause   {file, line, symbol, mechanism: [words]}   the injected site
  declaration  {sibling, lacks, file}                     H2 only: who lacks which declaration
  lapsed       {anchor, file}                             H2 only: the entry whose bytes moved
  pruned       {face, entry, line, symptom}               H3 only: the face and the missing cut
  contract     {file, line, text}                         H4 only: the doc line it contradicts
  fix          {file, anchor, forbidden: [tokens]}         the documented fix and what it is not
  red / green  {command, exit, evidence}                   the self-proof this build ran

The answer is scored on:
  root_cause_hit   truth.root_cause.file named, AND a `<file>:N` with N within 3 lines of
                   truth.line, AND at least half of truth.root_cause.mechanism present. The line is
                   required: the first round let the word list stand in for it and a line-less
                   answer passed.
  instrument_calls lines of the log that name a tool. Null when there is no log, because counting
                   from the answer's prose is guessing.
  init_calls       the subset of those whose command is `init`: index setup, counted apart so an
                   index cost is not read as an answer cost. answering_calls = the difference.
  steps            instrument calls plus the lines of a sibling `<log>.shell.jsonl` when the arm kept
                   one; otherwise equal to instrument_calls, with a note saying the shell steps are
                   not in this log
  response_chars   the sum of the responses' lengths — null when no log
  tokens_raw       (sum of request_chars + response_chars) / 3.5, and marked as an estimate
  counter_proof    the answer carries at least one tool invocation anywhere on a line AND at least
                   one explicit exit code (`exit N`, `exited N`, `rc=N`) — the evidence discipline
                   the brief demands
  minimal_fix      the answer names truth.fix.file AND contains truth.fix.anchor AND contains none
                   of truth.fix.forbidden
  shortcut_taken   the first of the class's must-refuse patterns the answer matches, or null
"""

# A command is a tool invocation anywhere on the line, not only at its start: answers write their
# evidence as `evidence — $ nichlink-mcp …`, and a rule that only looked at column zero would score
# every honestly cited command as absent.
# 命令是行内任意位置的工具调用，不只在行首：答案把证据写成 `evidence — $ nichlink-mcp …`，而只看第 0 列的
# 规则会把每一条如实引用的命令都判成没写。
COMMAND_LINE = re.compile(
    r"(?:^|[\s`$>])(?:cargo|nichlink|nichlink-mcp|rg|grep|git|ls|cat|diff|python3)\s+\S"
)
EXIT_CODE = re.compile(r"\b(?:exit|exited|rc)\s*[:=]?\s*(\d{1,3})\b")


def run(command, cwd, check=True):
    """Run one command, returning (exit, combined output)."""
    done = subprocess.run(command, cwd=str(cwd), capture_output=True, text=True)
    output = done.stdout + done.stderr
    if check and done.returncode != 0:
        raise SystemExit(
            f"`{' '.join(map(str, command))}` failed ({done.returncode}):\n{output[-4000:]}"
        )
    return done.returncode, output


def write(path, text):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(text, encoding="utf-8")


def host_face(name, kind, family):
    """One sibling face: it implements the parent's handle and computes its offset in `family`."""
    return f'''//! The {name} face.

use crate::control::{{ControlFrame, ControlHandle, {family}}};

pub struct {kind};

impl ControlHandle for {kind} {{
    /// Paint this widget onto the frame it was handed.
    fn paint(&self) -> ControlFrame {{
        ControlFrame
    }}
}}

/// This widget's offset, in the coordinate family its siblings use.
pub fn offset(x: i32) -> i32 {{
    {family}(x)
}}

crate::control_object! {{
    kind: {kind},
    exports: ["control.render"],
    parent: crate::control::NODE_ID,
    handle_contracts: [crate::control::ControlHandle],
}}
'''


def graft_face(name, kind):
    """The out-of-project replacement for one sibling, declared with `external_object!`."""
    return f'''//! The out-of-project replacement for `{kind}`.

use nichlink_toolchain::runtime::registry_core::{{
    ContractId, FlowContract, NoParts, NoPreset, RegistrationRule, root_node_id,
}};

pub struct {kind}Fast;

nichlink_toolchain::runtime::external_object! {{
    source: "{name}_fast/{name}_fast.rs",
    kind: {kind}Fast,
    preset: NoPreset,
    parts: NoParts,
    name: {{ zh: "快速{name}", en: "Fast {name}" }},
    summary: {{ zh: "项目外实现", en: "Out-of-project implementation" }},
    exports: ["control.render"],
    needs_registry: false,
    parent: root_node_id(env!("CARGO_PKG_NAME")),
    getting_from_other_registry: None,
    registry_rule_path: "{name}_fast/{name}_fast.rs",
    registry_rule: RegistrationRule::ANY,
    handle_traits: ["ControlHandle"],
    requires: [],
    provides: [],
    flow: FlowContract::new(
        ContractId::new("control.render.v1"),
        1,
        "ControlInput",
        "ControlFrame",
    ),
    runtime_checks: [],
}}
'''


def control_face():
    """The parent face's file, which is also where the two coordinate families live.

    They live here because the generated module tree mounts exactly the faces the build selected and
    nothing else: a helper file of its own is never mounted, so a name defined outside a mounted file
    cannot be called at all. Measured while building this bench.
    两个坐标系函数住在父面自己的文件里，因为生成树只挂载构建选中的那些面：单独一个辅助文件永远不会被挂载，
    因此定义在挂载文件之外的名字根本调不到。这是做出题台时量到的。
    """
    return (
        "//! The control folder face, the two coordinate families its children may use, and the\n"
        "//! handle every direct child implements.\n"
        "\n"
        "/// The local family: offsets are measured from the widget's own origin.\n"
        f"pub fn to_local(x: i32) -> i32 {{ x + {LOCAL_BIAS} }}\n"
        "\n"
        "/// The world family: offsets are measured from the frame's origin.\n"
        f"pub fn to_world(x: i32) -> i32 {{ x + {WORLD_BIAS} }}\n"
        "\n"
        "/// The frame a parent face hands to its children for painting.\n"
        "pub struct ControlFrame;\n"
        "\n"
        "/// The interface every direct child must implement.\n"
        "pub trait ControlHandle {\n"
        "    fn paint(&self) -> ControlFrame;\n"
        "}\n"
        "\n"
        "pub struct Control;\n"
        "\n"
        "crate::root_object! {\n"
        "    kind: Control,\n"
        "    needs_registry: true,\n"
        '    parent: crate::root_node_id(env!("CARGO_PKG_NAME")),\n'
        "}\n"
    )


def graft_lib():
    """The external crate's own registry, listing every replacement face."""
    modules = "\n".join(f"pub mod {name}_fast;" for name in WIDGETS + [PRUNED])
    listed = ",\n            ".join(f"{name}_fast::REGISTRATION" for name in WIDGETS + [PRUNED])
    return f'''//! An out-of-project crate: it takes no part in the host's generated tree.
//! 项目外 crate：它不参与宿主那棵生成树。

use nichlink_toolchain::runtime::registry_core::{{FrameworkId, Registry}};

/// Must match the host framework, or the overlay rejects this tree.
pub const FRAMEWORK: FrameworkId = FrameworkId::new("nichlink.example.control-button");

{modules}

/// The external implementation's own registry.
pub fn external_registry() -> Registry {{
    let mut registry = Registry::root_for_namespace(FRAMEWORK, env!("CARGO_PKG_NAME"));
    registry
        .register_all(&[
            {listed},
        ])
        .expect("external face registers");
    registry
}}
'''


def patch_entry(entry, declared):
    """Replace the entry's graft plan with one cut per declared sibling, in WIDGETS order."""
    text = entry.read_text(encoding="utf-8")
    marker = "nichlink_toolchain::runtime::static_graft_plan!("
    if marker not in text:
        raise SystemExit(f"{entry} no longer declares a graft plan — the example's shape changed")
    start = text.index(marker)
    end = text.index("\n);", start) + len("\n);")
    cuts = "\n".join(
        f"    cut(crate::control::object::{name}::NODE_ID)\n"
        f"        graft(control_button_graft::{name}_fast::NODE_ID),"
        for name in declared
    )
    plan = f"{marker}\n    FRAMEWORK,\n{cuts}\n);"
    return text[:start] + plan + text[end:]


def checkout_tree(directory):
    """Lay down the base: the example host and its graft crate, repointed and stripped.

    The example's own `tests/` and `examples/` are dropped rather than kept: they assert a two-child
    tree, and a bench tree whose shipped assertions are red before any injection is a tree nobody can
    read a symptom from. What replaces them is written by each class.
    丢掉示例自己的 `tests/` 与 `examples/`：它们断言的是两子级的树，而一棵"未注入就红"的题树没人能从中
    读出症状。替代它们的东西由每个类自己写下。
    """
    directory = Path(directory)
    if directory.exists():
        shutil.rmtree(directory)
    directory.mkdir(parents=True)
    host = directory / "host"
    graft = directory / "graft"
    shutil.copytree(
        TEMPLATE_HOST, host, ignore=shutil.ignore_patterns("target", "tests", "examples")
    )
    shutil.copytree(TEMPLATE_GRAFT, graft, ignore=shutil.ignore_patterns("target"))
    for manifest, replacements in [
        (
            host / "Cargo.toml",
            {
                'path = "../../toolchain"': f'path = "{CHECKOUT / "toolchain"}"',
                'path = "../control-button-graft"': f'path = "{graft}"',
            },
        ),
        (
            graft / "Cargo.toml",
            {'path = "../../toolchain"': f'path = "{CHECKOUT / "toolchain"}"'},
        ),
    ]:
        text = manifest.read_text(encoding="utf-8")
        for old, new in replacements.items():
            if old not in text:
                raise SystemExit(
                    f"{manifest} no longer spells `{old}` — the example's shape changed, and this "
                    "bench refuses to guess a new one"
                )
            text = text.replace(old, new)
        # An empty `[workspace]` table detaches the package from the enclosing workspace, which is
        # what keeps a run tree buildable while it lives under the checkout's own `target/`. Without
        # it cargo refuses with "current package believes it's in a workspace when it's not" — and the
        # first fix for that was to move the whole run to `/tmp`, where one cleanup deleted it.
        # 空的 `[workspace]` 表把包从外层工作区摘出来，这正是题树住在检出自己的 `target/` 下仍能构建的原因。
        # 没有它，cargo 会报 "believes it's in a workspace when it's not"——而当初对这条报错的"修法"是把整轮
        # 搬到 `/tmp`，结果一次清理就把它删了。
        manifest.write_text(text + "\n[workspace]\n", encoding="utf-8")
    return host, graft


def write_widgets(host, graft, declared, family_overrides):
    """Write every face: the parent (with both families), the children, and their replacements."""
    write(host / "src/control/control.rs", control_face())
    write(
        host / "src/control/registry_rule/registry_rule.rs",
        "//! The control parent's minimum structure for a direct child.\n"
        "\n"
        "use crate::RegistrationRule;\n"
        "\n"
        "pub const REGISTRATION_RULE: RegistrationRule = RegistrationRule::new()\n"
        '    .require_exports(&["control.render"]);\n',
    )
    for name in WIDGETS + [PRUNED]:
        kind = name.capitalize()
        write(
            host / f"src/control/object/{name}/{name}.rs",
            host_face(name, kind, family_overrides.get(name, "to_local")),
        )
        write(graft / f"src/{name}_fast.rs", graft_face(name, kind))
    write(graft / "src/lib.rs", graft_lib())
    for stale in sorted((graft / "src").glob("*.rs")):
        if stale.name != "lib.rs" and stale.name not in {
            f"{name}_fast.rs" for name in WIDGETS + [PRUNED]
        }:
            stale.unlink()
    # The example keeps a child roster file for some layouts; the generated tree discovers children
    # from the folder layout, so a stale roster would be a second, disagreeing list.
    # 示例里某些布局保留了子对象名册文件；生成树是按目录布局发现子对象的，因此残留的名册会变成第二份
    # 会分歧的清单。
    roster = host / "src/control/object/object.rs"
    if roster.exists():
        roster.unlink()
    entry = host / "src/lib.rs"
    entry.write_text(patch_entry(entry, declared), encoding="utf-8")


def offsets_test(count):
    """A rendering test whose number is right only when every sibling uses the local family.

    The assertion deliberately carries the **total**, not the per-widget value: the symptom a
    maintainer sees is a layout that is off, and naming the widget in the failing message would hand
    over the half of the answer the sibling comparison exists to produce.
    断言刻意只给**总量**，不给每个对象的值：维护者看到的症状是布局偏了，而在失败信息里点名那个对象，等于把
    "同族比较"本该产出的那一半答案直接送出去。
    """
    calls = " +\n        ".join(
        f"control_button::control::object::{name}::offset(10)" for name in WIDGETS
    )
    expected = count * (10 + LOCAL_BIAS)
    return f'''//! The rendered layout: every sibling's offset, added up.
//! 渲染出的布局：每个兄弟的偏移加总。

/// The frame this tree renders when every widget places itself the way its siblings do.
const EXPECTED_TOTAL: i32 = {expected};

#[test]
fn the_rendered_offsets_add_up() {{
    let total =
        {calls};
    assert_eq!(
        total, EXPECTED_TOTAL,
        "the rendered offsets add up to {{total}}, not {{EXPECTED_TOTAL}}"
    );
}}
'''


