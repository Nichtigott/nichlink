def fingerprint(root, files):
    """The adoption ledger's fingerprint: the kernel's own algorithm, re-spelled here for the bench.

    `path` + NUL + `len(contents)` + NUL + `contents` + NUL per file in path order, then SHA-256. The
    bench has to write a fingerprint a *person* could have written, so it recomputes the algorithm
    rather than copying a value out of the ledger it is about to write.
    指纹算法：按路径序，逐文件拼 `path` + NUL + 长度 + NUL + 内容 + NUL，再 SHA-256。出题台要写的是
    **人也能写出**的指纹，因此它重算这条算法，而不是从自己即将写下的台账里抄一个值。
    """
    digest = hashlib.sha256()
    for relative in sorted(files):
        data = (Path(root) / relative).read_bytes()
        digest.update(relative.encode())
        digest.update(b"\0")
        digest.update(str(len(data)).encode())
        digest.update(b"\0")
        digest.update(data)
        digest.update(b"\0")
    return digest.hexdigest()


def ledger_line(root, anchor, certifies, files, reason, at="2026-10-01T10:00:00+08:00"):
    """One ledger line, with the fingerprint computed from the bytes it names right now."""
    return (
        f"{anchor}|{certifies}|traced once|nich|{at}|{','.join(files)}|"
        f"{fingerprint(root, files)}|{reason}\n"
    )


def tree_digest(root):
    """One hash over every file a tree is made of, so a run can say which bytes it judged.

    `target/` and `.codegraph/` are left out: they are build output and an index the answerer makes,
    not the question. Everything else counts, including the graft crate and the ledger, because a
    change to any of them is a change to the question.
    `target/` 与 `.codegraph/` 不计：那是构建产物与答题方建的索引，不是题目。其余全部计入，包括 graft
    crate 与台账——它们任一改动都等于改了题。
    """
    digest = hashlib.sha256()
    for path in sorted(Path(root).rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(root)
        if relative.parts and relative.parts[0] in {"target", ".codegraph", ".audit"}:
            continue
        if any(part in {"target", ".codegraph"} for part in relative.parts):
            continue
        digest.update(str(relative).encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def apparatus(directory):
    """The three hashes a run must register: the questions, the recipe, and the judge.

    The first round measured a gap here — the trees were frozen before the arms started while the
    recipe and the scorer were still being repaired, so "the criteria were registered in advance"
    held for the questions and not for the two things that turn them into numbers.
    第一轮量到这个洞：树在两臂开工前就冻住了，而配方与判分器还在修，于是"判据预先登记"只对题目成立、
    对把它们变成数字的那两样不成立。
    """
    return {
        "tool": str(TOOL),
        "tool_sha256": hashlib.sha256(TOOL.read_bytes()).hexdigest(),
        "tree_sha256": tree_digest(directory),
    }


def first_lines(text, count=12):
    """The evidence a `red`/`green` entry carries: the tail, where the compiler and the harness
    actually say what happened."""
    rows = [row for row in text.splitlines() if row.strip()]
    return "\n".join(rows[-count:])


def bridge_binary():
    """This checkout's one-shot bridge, built if it is not there.

    The bench drives the tool it is measuring rather than a copy of it: a tree scored against a
    hand-rolled approximation would measure the approximation.
    出题台驱动的是它要测的那个工具，而不是它的复制品：对着手搓的近似物判分，量到的是那个近似物。
    """
    binary = CHECKOUT / "target/debug/nichlink-mcp"
    if not binary.exists():
        run(
            [
                "cargo",
                "build",
                "-p",
                "nichlink-toolchain",
                "--offline",
                "--features",
                "mcp",
                "--bin",
                "nichlink-mcp",
            ],
            CHECKOUT,
        )
    return str(binary)


def cli_binary():
    """This checkout's CLI, which is what writes `target/nichlink/out` — the scope lines' evidence.

    Every face class runs it: without those artifacts a tree that has a build-time scope answers
    `scope unknown`, and the third class's decisive fact is exactly that scope. Building the trees
    unbuilt would make the class unanswerable and the other two unrealistic.
    每个面类都跑它：没有那些产物，一棵**有**构建期作用域的树会答 `scope unknown`，而第三个类的决定性事实
    正是那个作用域。让题树停在未构建态，会让第三个类答不了、另两个类不真实。
    """
    binary = CHECKOUT / "target/debug/nichlink"
    if not binary.exists():
        run(
            [
                "cargo",
                "build",
                "-p",
                "nichlink-toolchain",
                "--offline",
                "--features",
                "cli",
                "--bin",
                "nichlink",
            ],
            CHECKOUT,
        )
    return str(binary)


def scope_sources(host):
    """The sources the build selected, read out of the manifest it wrote."""
    manifest = host / "target/nichlink/out/source_scope.tsv"
    if not manifest.exists():
        raise SystemExit(f"the build wrote no scope at {manifest}")
    rows = []
    for line in manifest.read_text(encoding="utf-8").splitlines():
        if line.startswith("#") or not line.strip():
            continue
        fields = line.split("\t")
        if len(fields) >= 2:
            rows.append(fields[1])
    return rows


def graft_plan_line(host):
    """The 1-based line the entry's graft plan starts on."""
    text = (host / "src/lib.rs").read_text(encoding="utf-8")
    return text[: text.index("nichlink_toolchain::runtime::static_graft_plan!")].count("\n") + 1


def mechanism_words(klass):
    """The words that name this class's mechanism — the scoring key *and* what the brief may not say.

    One implementation on purpose. The scorer reads this list to ask "did the answer name the
    mechanism?", so the brief's leak guard has to read the same list: a guard with its own copy would
    drift, and a guard that drifts either lets a leak through or refuses a clean brief.
    有意只做一份：判分器读这张表来问"答案有没有点名机制"，因此题面的泄漏守卫必须读同一张表——守卫自带
    一份副本会漂移，而漂移的守卫要么放走泄漏，要么拒绝一份干净的题面。
    """
    if klass == "h1-supply-chain":
        return ["to_world", "world"]
    if klass == "h2-claim-unkept":
        return ["handle_contracts", "handle_traits"]
    if klass == "h3-cross-file-chain":
        return [PRUNED, "cut"]
    return ["ZeroArm::Post", "zero_arm"]


def brief_leaks(klass, text):
    """Every mechanism word this brief spells out, with the line it sits on.

    Audit D6, measured on round 1's own briefs: h1's class line said "relative vs world space" and
    h3's said "the new face's cut" — one word each, and each word is half of that class's mechanism
    vocabulary. The agent does not need the mechanism's own name to recognise the shape; naming it
    hands over the grep.
    D6，在第一轮自己的题面上量到：h1 的类描述写着 "relative vs world space"，h3 的写着 "the new
    face's cut"——各一个词，而每个词都是那一类机制词表的一半。认出形状**不需要**机制自己的名字；说出名字
    等于把那条 grep 递过去。
    """
    words = mechanism_words(klass)
    found = []
    for index, line in enumerate(text.splitlines(), 1):
        for word in words:
            if word in line:
                found.append((index, word, line.strip()))
    return found


def root_cause_for(klass, host):
    """The injected site, read back out of the file the injection wrote."""
    if klass == "h1-supply-chain":
        relative = f"src/control/object/{H1_OUTLIER}/{H1_OUTLIER}.rs"
        text = (host / relative).read_text(encoding="utf-8")
        line = next(
            index + 1 for index, row in enumerate(text.splitlines()) if "to_world(x)" in row
        )
        return {
            "file": relative,
            "line": line,
            "symbol": "offset",
            "mechanism": mechanism_words(klass),
        }
    if klass == "h2-claim-unkept":
        relative = f"src/control/object/{H2_UNDECLARED}/{H2_UNDECLARED}.rs"
        text = (host / relative).read_text(encoding="utf-8")
        # The anchor is where the declaration **would** sit, not the line it was removed from: the
        # generated order ends `… parent: …, handle_contracts: …, }`, so after the removal the gap is
        # the line right after `parent:`. Anchoring on `parent:` itself made the column report a hit
        # for a line the answer had not located (round 1, audit D5).
        # 锚点是那条声明**本该**在的位置，不是它被删掉的那一行：生成顺序以 `… parent: …,
        # handle_contracts: …, }` 收尾，因此删掉之后空缺就是 `parent:` 的下一行。锚在 `parent:` 本身上，
        # 会让那一栏对一行答案其实没定位到的行报命中（第一轮审计 D5）。
        line = next(
            index + 1
            for index, row in enumerate(text.splitlines())
            if "parent: crate::control::NODE_ID" in row
        ) + 1
        return {
            "file": relative,
            "line": line,
            "symbol": H2_UNDECLARED,
            "mechanism": mechanism_words(klass),
        }
    if klass == "h3-cross-file-chain":
        # The line is the entry's graft plan, where the missing cut belongs. Leaving it null made
        # every answer fail the line column for a reason that was the recipe's, not the answerer's
        # (round 1, audit: `truth line=null 故 line_within_3 两臂皆 false`).
        # 行号是入口的 graft 计划，也就是缺的那条切口该在的位置。留 null 会让每个答案都因为**配方**的
        # 原因在行号那一栏失败，而不是因为答题方（第一轮审计）。
        return {
            "file": "src/lib.rs",
            "line": graft_plan_line(host),
            "symbol": "static_graft_plan",
            "mechanism": mechanism_words(klass),
        }
    return {
        "file": "src/model/entry.rs",
        "line": None,
        "symbol": "zero_arm",
        "mechanism": mechanism_words(klass),
    }


def refusals_for(klass):
    """The shortcuts each class must refuse, as patterns the scorer matches mechanically.

    They are written as *claims* rather than as words: "the outlier is slider" is a refusal whatever
    sentence carries it, and a scorer that looked for a phrase would reward the phrasing instead of
    the claim.
    这些捷径写成**断言**而不是词：无论哪句话承载"离群的是 slider"，它都是同一条捷径；而去找某个短语的判分
    只会奖励措辞、不会奖励断言。
    """
    if klass == "h1-supply-chain":
        return [
            r"outlier\W{0,20}(button|slider|timeline|gauge|spinner|panel|badge)",
            r"\b(I (guessed|assume)|probably|might be)\b",
        ]
    if klass == "h2-claim-unkept":
        return [
            r"ledger (has|holds|contains) \d+ entr",
            r"lapsed\W{0,40}(fix|repair|rewrite|edit|change the code)",
        ]
    if klass == "h3-cross-file-chain":
        return [
            r"file (is )?(missing|not there|does not exist)",
            r"\b(nothing to fix|no defect)\b",
        ]
    return [r"rewrite the file", r"change the test", r"delete the test"]


def fix_for(klass, truth):
    """The documented fix, and the edits it is not."""
    if klass == "h1-supply-chain":
        return {
            "file": truth["root_cause"]["file"],
            "anchor": "to_local",
            "forbidden": ["rewrite the file", "change the test"],
        }
    if klass == "h2-claim-unkept":
        return {
            "file": truth["declaration"]["file"],
            "anchor": "handle_contracts",
            "forbidden": ["delete the ledger", "remove the entry"],
        }
    if klass == "h3-cross-file-chain":
        return {
            "file": "src/lib.rs",
            "anchor": f"{PRUNED}_fast",
            "forbidden": ["delete the face", "remove the file"],
        }
    return {
        "file": "src/model/entry.rs",
        "anchor": "ZeroArm::Refuse",
        "forbidden": ["rewrite the file", "delete the test"],
    }


def prove(klass, host, truth):
    """Run the red command, apply the documented fix, run the green command, restore the tree.

    The proof is the bench's own, so it is run here and its raw numbers are stored rather than
    described. The tree is restored to its injected state afterwards, because the answerer must meet
    the defect and not the fix.
    自证由出题台自己跑，原始数字被存下来而不是被描述。跑完把树还原成注入态，因为答题方要遇到的是缺陷、
    不是修法。
    """
    if klass == "h2-claim-unkept":
        # This class's red is the diagnosis the class is about, not a failing build: the tree compiles
        # and its tests pass, and what holds the defect is the ledger. The two commands are the ones
        # the answer's ideal path uses, read through this checkout's own bridge.
        # 这一类的红是它要问的那个诊断，而不是一次失败的构建：树编得过、测试也过，病灶在台账里。两条命令
        # 正是答案理想路径要用的那两次，经本检出自己的桥读出。
        bridge = bridge_binary()
        red_exit, red_out = run(
            [bridge, "consistency", "--root", ".", "--specimen", truth["specimen"]],
            host,
            check=False,
        )
        green_exit, green_out = run(
            [bridge, "conformance", "--root", ".", "--anchor", truth["lapsed"]["anchor"]],
            host,
            check=False,
        )
        return (
            {
                "command": f"nichlink-mcp consistency --root . --specimen {truth['specimen']}",
                "exit": red_exit,
                "evidence": first_lines(red_out),
            },
            {
                "command": f"nichlink-mcp conformance --root . --anchor {truth['lapsed']['anchor']}",
                "exit": green_exit,
                "evidence": first_lines(green_out),
            },
        )

    red_exit, red_out = run(["cargo", "test", "--offline", "--quiet"], host, check=False)
    if red_exit == 0:
        raise SystemExit(
            "the injection is not red: `cargo test` passed on the injected tree, so this is a story "
            "rather than a question"
        )
    fix = fix_for(klass, truth)
    target = host / fix["file"]
    original = target.read_text(encoding="utf-8")
    if klass == "h1-supply-chain":
        # Both halves of the drift, because they are one edit: the call and the import that names the
        # family. Replacing only the call leaves a file that calls a name it does not import, which is
        # a second defect rather than a fix.
        # 漂移的两半，因为它们是**一处**改动：调用本身，以及点名那一族的导入。只换调用会留下一个"调了没
        # 导入的名字"的文件，那是第二个缺陷而不是修法。
        patched = original.replace("to_world", "to_local")
    elif klass == "h3-cross-file-chain":
        patched = patch_entry_text(
            original,
            WIDGETS + [PRUNED],
        )
    else:
        raise SystemExit(f"no fix is implemented for {klass}")
    target.write_text(patched, encoding="utf-8")
    green_exit, green_out = run(["cargo", "test", "--offline", "--quiet"], host, check=False)
    target.write_text(original, encoding="utf-8")
    if green_exit != 0:
        raise SystemExit(
            f"the documented fix is not green: `cargo test` exited {green_exit} after applying it\n"
            f"{green_out[-2000:]}"
        )
    # And the injected tree must be red again after the restore, or the proof above could have been
    # about a tree that was never broken.
    # 还原之后注入树必须重新变红，否则上面那次自证可能针对的是一棵根本没坏过的树。
    again_exit, _ = run(["cargo", "test", "--offline", "--quiet"], host, check=False)
    if again_exit == 0:
        raise SystemExit("restoring the injection did not restore the red")
    return (
        {"command": "cargo test --offline", "exit": red_exit, "evidence": first_lines(red_out)},
        {"command": "cargo test --offline", "exit": green_exit, "evidence": first_lines(green_out)},
    )


def patch_entry_text(text, declared):
    """Replace the graft plan in a **string** the same way `patch_entry` does in a file."""
    marker = "nichlink_toolchain::runtime::static_graft_plan!("
    start = text.index(marker)
    end = text.index("\n);", start) + len("\n);")
    cuts = "\n".join(
        f"    cut(crate::control::object::{name}::NODE_ID)\n"
        f"        graft(control_button_graft::{name}_fast::NODE_ID),"
        for name in declared
    )
    return text[:start] + f"{marker}\n    FRAMEWORK,\n{cuts}\n);" + text[end:]


def brief(directory, klass, truth):
    """The task text: the symptom and the deliverable, never the answer."""
    recipe = next(entry for entry in CLASSES if entry[0] == klass)
    fields = [
        "`root cause` — the file and line you believe the defect is at",
        "`mechanism`  — why that line produces the symptom, in your own words",
        "`evidence`   — for every claim: the command you ran, its raw output, and its exit code",
        "`counter-proof` — one thing you did that would have shown your diagnosis wrong",
        "`fix`        — the smallest edit, and which files you did **not** touch",
    ]
    symptom = {
        "h1-supply-chain": (
            "The rendered layout is off. `cargo test --offline` fails in the offsets test with a "
            "total that no single widget's own code explains, and every widget file reads as correct "
            "on its own."
        ),
        "h2-claim-unkept": (
            "A constraint this design adopted is not holding on a later sibling, and one ledger "
            "entry no longer describes the bytes it names. The tree builds and its tests pass: the "
            "question is what the ledger and the sibling shapes say, not what a test run says."
        ),
        "h3-cross-file-chain": (
            "A widget that exists in the sources does not appear in the shipped registry tree. "
            "`cargo test --offline` fails on the shipped-tree assertion."
        ),
        "h4-one-file-many-algorithms": (
            "One algorithm in one file does the opposite of what its own documentation promises, "
            "and no test covers the branch that does it. `cargo test --offline` is green."
        ),
    }[klass]
    text = f"""# {klass}

## Symptom

{symptom}

## Deliverable

Answer with these five fields, each on its own line, and keep the labels:

{chr(10).join(fields)}

The tree is **read-only**: do not edit it, and do not change a test. Every claim needs the command
you ran, its raw output and its exit code — "I verified it" is not evidence.

## The class

{recipe[1]}
{recipe[2]}

Diagnose the cause. Do not rewrite a file, and do not make a symptom disappear by changing a test.
"""
    write(Path(directory) / "BRIEF.md", text)
    leaks = brief_leaks(klass, text)
    if leaks:
        raise SystemExit(
            "the brief names its own mechanism (audit D6) — rewrite the class line so it describes "
            "the shape without the mechanism's vocabulary:\n"
            + "\n".join(f"  line {line}: `{word}` in {row}" for line, word, row in leaks)
        )


def build_algorithms(directory, klass):
    """The fourth class: a plain crate, three algorithms in one file, one branch inverted.

    Plain on purpose. This class is about one file's own logic, so it needs no registration tree, no
    build step and no scope — and a crate with no dependencies builds in seconds, which is what makes
    the red/green self-proof cheap enough to run on every build. Its red is not a failing run either:
    the recipe says the default face is green, so what must name the defect is the census's branch
    column.
    有意做成普通 crate：这一类说的是一个文件自己的逻辑，因此不需要注册树、构建步骤与作用域——而没有依赖
    的 crate 几秒就能构建，这正是让红/绿自证便宜到每次 build 都跑得起的原因。它的红也不是"运行失败"：
    配方说默认面是绿的，因此点名缺陷的必须是普查的分支栏。
    """
    directory = Path(directory)
    if directory.exists():
        shutil.rmtree(directory)
    (directory / "src/model").mkdir(parents=True)
    (directory / "tests").mkdir(parents=True)
    write(
        directory / "Cargo.toml",
        '[package]\nname = "hardbug-algorithms"\nversion = "0.1.0"\nedition = "2024"\n'
        "\n[workspace]\n",
    )
    write(
        directory / "src/lib.rs",
        '//! A ledger model.\n\n#[path = "model/model.rs"]\npub mod model;\n',
    )
    write(
        directory / "src/model/model.rs",
        '#[path = "entry.rs"]\npub mod entry;\n',
    )
    entry = (
        "//! Entries.\n"
        "\n"
        "/// Which arm decides a zero amount.\n"
        "#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n"
        "enum ZeroArm {\n"
        "    /// A zero entry is posted like any other.\n"
        "    Post,\n"
        "    /// A zero entry is refused.\n"
        "    Refuse,\n"
        "}\n"
        "\n"
        "/// One entry: a signed amount against an account.\n"
        "#[derive(Clone, Debug, PartialEq, Eq)]\n"
        "pub struct Entry {\n"
        "    /// The account this entry belongs to.\n"
        "    pub account: String,\n"
        "    /// The amount; negative is a debit.\n"
        "    pub amount: i64,\n"
        "    /// Whether the entry carries a receipt.\n"
        "    pub has_receipt: bool,\n"
        "}\n"
        "\n"
        "impl Entry {\n"
        "    /// A new entry.\n"
        "    pub fn new(account: &str, amount: i64, has_receipt: bool) -> Self {\n"
        "        Self { account: account.to_owned(), amount, has_receipt }\n"
        "    }\n"
        "\n"
        "    /// Which arm decides a zero amount.\n"
        "    fn zero_arm(&self) -> ZeroArm {\n"
        "        ZeroArm::Post\n"
        "    }\n"
        "\n"
        "    /// Whether this entry may be posted at all.\n"
        "    ///\n"
        "    /// The rule the service leans on: an entry is postable when it carries a receipt, and a\n"
        "    /// zero entry never is. Callers rely on the refusal, so this is a contract.\n"
        "    pub fn postable(&self) -> bool {\n"
        "        if !self.has_receipt {\n"
        "            return false;\n"
        "        }\n"
        "        match self.zero_arm() {\n"
        "            ZeroArm::Post => true,\n"
        "            ZeroArm::Refuse => false,\n"
        "        }\n"
        "    }\n"
        "\n"
        "    /// The entry's magnitude, as the report prints it.\n"
        "    ///\n"
        "    /// Always non-negative: a debit prints as its size, never with a sign. That is what\n"
        "    /// this function promises, and the contract is why it is one of the three algorithms\n"
        "    /// this file carries rather than a formatting detail.\n"
        "    pub fn signed(&self) -> i64 {\n"
        "        if self.amount < 0 { -self.amount } else { self.amount }\n"
        "    }\n"
        "\n"
        "    /// The account this entry is filed under, normalized.\n"
        "    ///\n"
        "    /// Accounts are case-insensitive and trimmed.\n"
        "    pub fn normalized_account(&self) -> String {\n"
        "        self.account.trim().to_lowercase()\n"
        "    }\n"
        "}\n"
    )
    write(directory / "src/model/entry.rs", entry)
    write(
        directory / "tests/postable.rs",
        "use hardbug_algorithms::model::entry::Entry;\n"
        "\n"
        "#[test]\n"
        "fn a_receipted_entry_posts() {\n"
        '    assert!(Entry::new("a", 5, true).postable());\n'
        "}\n"
        "\n"
        "#[test]\n"
        "fn an_entry_without_a_receipt_does_not_post() {\n"
        '    assert!(!Entry::new("a", 5, false).postable());\n'
        "}\n",
    )
    exit_code, output = run(["cargo", "test", "--offline", "--quiet"], directory, check=False)
    if exit_code != 0:
        raise SystemExit(
            "this class ships a green default face on purpose; a red one means the fixture moved:\n"
            f"{output[-2000:]}"
        )
    zero_arm = next(
        index + 1 for index, row in enumerate(entry.splitlines()) if "ZeroArm::Post\n" in row + "\n"
    )
    dead_arm = next(
        index + 1 for index, row in enumerate(entry.splitlines()) if "ZeroArm::Refuse =>" in row
    )
    contract = next(
        index + 1
        for index, row in enumerate(entry.splitlines())
        if "zero entry never is" in row
    )
    bridge = bridge_binary()
    red_exit, red_out = run(
        [bridge, "check", "--root", ".", "--face", "default", "--census"], directory, check=False
    )
    if "no construction of `ZeroArm::Refuse`" not in red_out:
        raise SystemExit(
            "the census's branch column does not name the dead arm, so this class has no red "
            f"fingerprint at all:\n{red_out[-2000:]}"
        )
    truth = {
        "class": klass,
        "tree": str(directory),
        "root_cause": {
            "file": "src/model/entry.rs",
            "line": zero_arm,
            "symbol": "zero_arm",
            "mechanism": mechanism_words(klass),
        },
        "contract": {
            "file": "src/model/entry.rs",
            "line": contract,
            "text": "an entry is postable when it carries a receipt, and a zero entry never is",
        },
        "dead_arm": {
            "enum": "ZeroArm",
            "variant": "Refuse",
            "file": "src/model/entry.rs",
            "line": dead_arm,
        },
        "pruned": None,
        "ledger": None,
        "fix": fix_for(klass, {"root_cause": {"file": "src/model/entry.rs"}}),
        "must_refuse": refusals_for(klass),
        "apparatus": apparatus(directory),
        "red": {
            "command": "nichlink-mcp check --root . --face default --census",
            "exit": red_exit,
            "evidence": "the default face is green by design; the red is the branch column, which "
            "names the arm this contract forbids",
        },
        "green": {"command": "cargo test --offline", "exit": exit_code, "evidence": "green"},
    }
    write(directory / ".audit/truth.json", json.dumps(truth, indent=2, sort_keys=True) + "\n")
    write(
        directory / ".audit/README.md",
        "The bench's own directory: the constructed truth. No task text points here.\n"
        "出题台自己的目录：构造出的真值。题面不指向这里。\n",
    )
    brief(directory, klass, truth)
    print(f"built {klass} at {directory}")
    print(f"  default face green (exit {exit_code}); the census names ZeroArm::Refuse at line "
          f"{dead_arm}")
    return 0


def durable_root(directory):
    """Refuse to be quiet about a run directory that a reboot can delete.

    Measured the hard way: the whole W8 round lived under `/tmp` — four trees, both arms' logs, the
    audit — and one cleanup took all of it. The session transcripts survived (they are not in `/tmp`),
    which is why the numbers could be recovered at all, but a frozen set has to be a file, not a
    memory. The tree cannot live inside the checkout instead (cargo absorbs it into the workspace),
    so the durable choice is a directory outside both: `~/.cache/nichlink-hardbug/<run>` or anywhere
    the user keeps data.
    这条是**付出代价换来的**：W8 整轮都住在 `/tmp` 下——四棵树、两臂日志、审计——一次清理全没了。会话
    记录不在 `/tmp` 所以活了下来（数才挖得回来），但冻结集必须是**文件**而不是记忆。题树也不能放进检出
    （会被 cargo 吸进工作区），所以耐久的落点是两者之外：`~/.cache/nichlink-hardbug/<run>` 或用户自己
    放数据的地方。
    """
    directory = Path(directory).resolve()
    volatile = ("/tmp/", "/var/tmp/", "/run/")
    if any(str(directory).startswith(prefix) for prefix in volatile):
        print(
            f"WARNING: {directory} is under a volatile path — a reboot or a tmp cleanup deletes the "
            "whole run (this happened once: W8's trees, logs and audit were all lost). Use "
            f"{CHECKOUT}/target/hardbug-runs/<run> instead.",
            file=sys.stderr,
        )
    return directory


def freeze(tree):
    """The pre-freeze checklist: what is in this tree that is not source, and what points outside it.

    Two apparatus defects from round 1, both reported by the control arm rather than by me, both
    cheap to check and expensive to notice:
    D7 — a `cp -a` copy is not independent: its manifest still points at the *original* tree's graft
         directory, so a run in the copy compiles the other arm's crate.
    D8 — a build-time self-proof leaves `target/nichlink/out/check-default.log` inside the tree; the
         artifacts have to be listed before the tree is frozen, and scanned for answer-bearing text.
    第一轮的两个装置缺陷，都是对照臂报出来而不是我发现的，都是"检查很便宜、注意到很贵"：
    D7 —— `cp -a` 出来的副本不独立：它的清单仍指向**原件**的 graft 目录，于是在副本里跑会编译另一臂的 crate。
    D8 —— 构建期自证会在树里留下 `target/nichlink/out/check-default.log`；冻结前必须把这些产物列出来，
    并扫一遍有没有带答案的文本。
    """
    root = Path(tree).resolve()
    if not root.exists():
        raise SystemExit(f"no tree at {root}")
    # The boundary is the **run**, not the host package: a tree is `<run>/<class>/{host,graft}`, and
    # the host's manifest naming its own sibling graft is correct. Taking `host/` as the boundary made
    # a clean tree report its own graft as an outside reference — the second false positive this check
    # produced, and the reason to run a new check against a clean tree before trusting it.
    # 边界是**整个 run**、不是 host 包：题树是 `<run>/<class>/{host,graft}`，host 清单点名它自己的兄弟
    # graft 是正确的。把 `host/` 当边界，会让一棵干净的树把自己的 graft 报成外部引用——这是这条检查产生的
    # 第二个假阳性，也正是"新检查先跑干净树"的理由。
    boundary = root.parent if root.name == "host" else root
    source = {".rs", ".toml", ".lock", ".md"}
    artifacts, outside = [], []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(root)
        parts = relative.parts
        if parts[0] in {"target", ".nichlink", ".audit"} or path.suffix not in source:
            artifacts.append(str(relative))
        if path.suffix in {".toml", ".lock"} or parts[0] == ".nichlink":
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            for needle in ("/tmp/", "/home/", "/Users/"):
                for line in text.splitlines():
                    if needle not in line or str(boundary) in line:
                        continue
                    # A tree legitimately depends on this checkout's own crates — the bench repoints
                    # `path` at them on purpose. Only those are allowed; anything else outside the
                    # tree is the coupling D7 is about. The first version flagged every absolute
                    # path, so a clean tree reported four references and the check cried wolf — the
                    # same false positive that makes a gate untrustworthy.
                    # 题树**本来就该**依赖检出自己的 crate——出题台有意把 `path` 重指到它们。只允许这些；
                    # 树外其它任何路径都是 D7 说的那种耦合。第一版把所有绝对路径都算上，于是一棵**干净**的树
                    # 也报 4 条——门禁喊狼来了，正是让门禁失去可信度的那种假阳性。
                    if any(
                        f"{CHECKOUT}/{crate}" in line
                        for crate in ("toolchain", "kernel", "macro", "conventions")
                    ):
                        continue
                    outside.append(f"{relative}: {line.strip()[:120]}")
    print(f"tree      {root}")
    print(f"source    {sum(1 for p in root.rglob('*') if p.is_file()) - len(artifacts)} file(s)")
    print(f"artifacts {len(artifacts)} (non-source or under target/ .nichlink/ .audit/)")
    for row in artifacts[:12]:
        print(f"  {row}")
    if len(artifacts) > 12:
        print(f"  … and {len(artifacts) - 12} more")
    print(f"outside   {len(outside)} absolute reference(s) that do not point at this tree (D7)")
    for row in outside[:12]:
        print(f"  {row}")
    return 0


def build(directory, klass):
    directory = durable_root(directory)
    if klass not in {name for name, *_ in CLASSES}:
        raise SystemExit(f"unknown class `{klass}`; `plan` names the four")
    if klass == "h4-one-file-many-algorithms":
        return build_algorithms(directory, klass)

    declared = WIDGETS if klass != "h3-cross-file-chain" else WIDGETS
    overrides = {H1_OUTLIER: "to_world"} if klass == "h1-supply-chain" else {}
    host, graft = checkout_tree(directory)
    write_widgets(host, graft, declared, overrides)

    truth = {"class": klass, "tree": str(directory), "pruned": None, "contract": None,
             "ledger": None}

    if klass == "h3-cross-file-chain":
        # The ninth face exists in both crates and in no cut: what fails to declare it is the entry.
        # 第九个面在两个 crate 里都在、且不在任何切口里：没声明它的是入口。
        entry = host / "src/lib.rs"
        text = entry.read_text(encoding="utf-8")
        line = text[: text.index("nichlink_toolchain::runtime::static_graft_plan!")].count("\n") + 1
        write(host / "tests/shipped.rs", shipped_test(WIDGETS + [PRUNED]))
        truth["pruned"] = {
            "face": f"root/control/{PRUNED}",
            "entry": "src/lib.rs",
            "line": line,
            "symptom": f"src/control/object/{PRUNED}/{PRUNED}.rs:9",
        }
    else:
        write(host / "tests/offsets.rs", offsets_test(len(WIDGETS)))

    if klass == "h2-claim-unkept":
        # A real ledger: one specimen the siblings are compared against, and one lapsed entry whose
        # fingerprint describes bytes that are no longer there.
        # 真台账：一条供兄弟比对的标本，以及一条指纹描述着"已经不在了的字节"的失效条目。
        specimen = "root/control/button"
        specimen_files = ["src/control/object/button/button.rs"]
        lapsed_files = [f"src/control/object/{H2_LAPSED}/{H2_LAPSED}.rs"]
        lines = [
            ledger_line(
                host,
                specimen,
                "the reference sibling shape",
                specimen_files,
                "the shape every sibling follows",
            )
        ]
        # The lapsed line is written against different bytes on purpose: a fingerprint that matches
        # is `provisional`, and this class needs one that does not.
        # 失效那条有意针对另一批字节写：指纹对得上就是 `provisional`，而这个类要的是一条对不上的。
        stale = fingerprint(host, specimen_files)
        lines.append(
            f"root/control/{H2_LAPSED}|the panel's original contract|traced once|nich|"
            f"2026-09-20T09:00:00+08:00|{','.join(lapsed_files)}|{stale}|"
            "recorded before the panel was rewritten\n"
        )
        write(host / ".nichlink/adopted/entries", "".join(lines))
        # The declaration this sibling is missing: `handle_contracts`, which every sibling states.
        # 这个兄弟缺的那条声明：`handle_contracts`，每个兄弟都写了它。
        face = host / f"src/control/object/{H2_UNDECLARED}/{H2_UNDECLARED}.rs"
        face.write_text(
            face.read_text(encoding="utf-8").replace(
                "    handle_contracts: [crate::control::ControlHandle],\n", ""
            ),
            encoding="utf-8",
        )
        truth["declaration"] = {
            "sibling": f"root/control/{H2_UNDECLARED}",
            "lacks": "handle_contracts",
            "file": f"src/control/object/{H2_UNDECLARED}/{H2_UNDECLARED}.rs",
        }
        truth["specimen"] = specimen
        truth["lapsed"] = {"anchor": f"root/control/{H2_LAPSED}", "file": lapsed_files[0]}

    run([cli_binary(), "check"], host, check=False)
    selected = scope_sources(host)
    truth["scope"] = {
        "selected": len(selected),
        "sources": selected,
    }
    if klass == "h3-cross-file-chain":
        # The class's decisive fact, asserted at build time: the face exists in the sources and the
        # build's own scope does not select it. If that ever stops being true the class is a story,
        # so the build refuses rather than shipping it.
        # 这个类的决定性事实在这里被构建期断言：那个面存在于源码里，而构建自己的作用域没有选中它。这件事
        # 一旦不再成立，这个类就成了故事，因此构建直接拒绝而不是把它发出去。
        if any(PRUNED in source for source in selected):
            raise SystemExit(
                f"the build selected `{PRUNED}`, so the entry does declare its cut and this class "
                "has nothing to ask"
            )
    truth["root_cause"] = root_cause_for(klass, host)
    truth["fix"] = fix_for(klass, truth)
    truth["must_refuse"] = refusals_for(klass)
    truth["apparatus"] = apparatus(directory)
    truth["red"], truth["green"] = prove(klass, host, truth)
    write(
        directory / ".audit/truth.json",
        json.dumps(truth, indent=2, sort_keys=True) + "\n",
    )
    write(
        directory / ".audit/README.md",
        "This directory is the bench's own: the truth `build` constructed, and the self-proof it "
        "ran. No task text points here.\n这个目录是出题台自己的：`build` 构造出的真值，以及它跑过的"
        "自证。题面不指向这里。\n",
    )
    brief(directory, klass, truth)
    print(f"built {klass} at {directory}")
    print(f"  red    {truth['red']['command']} -> exit {truth['red']['exit']}")
    print(f"  green  {truth['green']['command']} -> exit {truth['green']['exit']}")
    return 0


def normalize_log_record(record):
    """One log line as a dict: tool, whether it is index setup, and the characters each way.

    Three shapes are read, because two arms produce two of them and the bench's own documented shape is
    the third:
      * the bridge's own `--log`: `{"exit", "request": [argv…], "response": "…"}`
      * an arm's own log: `{"tool", "argv": […], "exit", "stdout_chars", "stderr_chars"}`
      * the bench's documented shape: `{"tool", "request_chars", "response_chars", "exit"}`
    A line that names no tool is not an instrument call: `--list` and a bare `--help` are lookups, and
    counting them would inflate the KPI the comparison turns on. `init` is an instrument call too, but
    it is index setup rather than answering, so it is counted apart — the rounds already fixed that
    convention and mixing them is how an index cost gets read as an answer cost.
    三种形状都读，因为两臂各产一种、而出题台自己文档里那种是第三种。没有点名工具的行不算仪器调用：
    `--list` 与裸 `--help` 是查表，算进去会灌水这次比较赖以成立的 KPI。`init` 也是仪器调用，但它是建索引
    而不是答题，因此单列——各轮已经定下这个口径，把两者混起来等于把索引成本读成答题成本。
    """
    if record.get("argv") is not None:
        argv = [str(part) for part in record["argv"]]
        received = record.get("stdout_chars")
        if received is None:
            received = len(str(record.get("stdout", ""))) + len(str(record.get("stderr", "")))
        else:
            received = int(received) + int(record.get("stderr_chars", 0))
        return {
            "tool": argv[0] if argv else None,
            "init": bool(argv) and argv[0] == "init",
            "sent": sum(len(part) for part in argv),
            "received": int(received),
            "argv": argv,
            "exit": record.get("exit"),
            "bridge": False,
        }
    if record.get("request") is not None:
        argv = record["request"]
        argv = [str(part) for part in argv] if isinstance(argv, list) else str(argv).split()
        tool = next((part for part in argv if not part.startswith("-")), None)
        return {
            "tool": tool,
            "init": tool == "init",
            "sent": sum(len(part) for part in argv),
            "received": len(str(record.get("response", ""))),
            "argv": argv,
            "exit": record.get("exit"),
            "bridge": True,
        }
    return {
        "tool": record.get("tool"),
        "init": record.get("tool") == "init",
        "sent": int(record.get("request_chars", 0)),
        "received": int(record.get("response_chars", 0)),
        "argv": [str(record.get("tool") or "")],
        "exit": record.get("exit"),
        "bridge": True,
    }


WASTE_DEFINITION = """A call is **wasted** when it is one of exactly three decidable things, read from the log alone:
  * `empty`               — the reply carries 0 characters;
  * `repeat`              — the same tool with the same arguments already ran earlier in this log;
  * `retry-after-refusal` — the previous call refused (exit != 0) and this one asks the same tool.
Everything else counts as work. A **first** refusal is work: its text is the information. So is a
second call with different arguments. `init` is index setup and is not judged here.
A call 是**白跑**，当且仅当它是下面三种**可从日志单独判定**之一：`empty` 回复 0 字符 · `repeat` 同一工具
同一参数在本日志里已经跑过 · `retry-after-refusal` 上一次被拒（exit != 0）而这一次又用同一个工具。
其余都算工作：**第一次**被拒是工作（拒绝文案就是信息），换参数的第二次调用也是工作。`init` 是建索引，不在此判定。
"""


def waste_report(rows):
    """Classify answering calls as wasted, by the definition above and nothing else.

    Round 1's arm reported "9 of 46 wasted" about itself and the audit **refused to accept it**: a
    self-reported waste list with no definition cannot be re-derived by a reader, so it is not
    evidence. This is that definition, in code, so the next round's number can be recomputed from the
    log by anyone — and so a wrong count shows up as a wrong classification rather than a dispute.
    第一轮那一臂自报"46 次里 9 次白跑"，审计**拒绝采信**：一份没有定义的自报浪费清单，读者无法重新推导，
    因此它不是证据。这里把定义写成代码，于是下一轮的数任何人都能从日志重算——而数错了会表现为**分类错了**，
    而不是一场争论。
    """
    seen, wasted, previous = set(), [], None
    for index, row in enumerate(rows, 1):
        key = (row.get("tool"), tuple(row.get("argv") or []))
        reason = None
        if row.get("received", 0) == 0:
            reason = "empty"
        elif key in seen:
            reason = "repeat"
        elif previous is not None and previous.get("exit") not in (0, None) and previous.get("tool") == row.get("tool"):
            reason = "retry-after-refusal"
        if reason:
            wasted.append({"index": index, "tool": row.get("tool"), "reason": reason})
        seen.add(key)
        previous = row
    counts = {name: sum(1 for row in wasted if row["reason"] == name)
              for name in ("empty", "repeat", "retry-after-refusal")}
    return {"wasted_calls": len(wasted), "wasted_breakdown": counts, "wasted_detail": wasted}


def tokens(target, tool_name="nichlink-mcp"):
    """Per-axis token account for one session, read **out of band**.

    Nothing about the task changes when this runs: it reads the harness's own session log after the
    fact. That is the point — a metric that needs a new deliverable has already changed the question,
    and the maintainer's constraint is that measuring must not move the thing being measured.
    它跑起来时任务一点没变：事后读 harness 自己的会话日志。这正是要点——需要新增交付物才能量的指标，
    已经改了那道题；而维护者的约束是"测量不许动被测量的东西"。

    The three axes are the provider's own numbers, not an estimate:
      input  = inputTokens + cacheReadTokens + cacheWriteTokens   (the prompt, re-sent every step)
      output = outputTokens                                       (what the model generated)
    They are priced differently, so they are never added into one figure here.
    三档是 provider 自己报的数、不是估算：输入＝prompt（每步都要重发），输出＝模型生成的。两者单价不同，
    因此这里从不合成一个数。

    `zstd -dc` rather than a library: the file is a concatenation of zstd frames, and node's
    `zstdDecompressSync` stops at the first one (a 585 KB transcript decoded to 284 bytes).
    用 `zstd -dc` 而不是库：文件是多帧拼接的 zstd，node 的 `zstdDecompressSync` 只解第一帧
    （585 KB 的记录只吐出 284 字节）。
    """
    path = Path(target)
    if path.is_dir():
        candidates = sorted(path.glob("session*.jsonl.zstd"))
        if not candidates:
            raise SystemExit(f"no session log under {path}")
        path = candidates[0]
    done = subprocess.run(["zstd", "-dc", str(path)], capture_output=True, text=True)
    if done.returncode != 0:
        raise SystemExit(f"cannot decompress {path}: {done.stderr[-400:]}")
    label = None
    steps = tool_calls = 0
    # Steps, read out of band (audit D2). The harness writes one `tool/call` per command, so the step
    # count never has to come from the arm's own bookkeeping — and asking an arm to keep a shell log
    # would be a **new deliverable**, i.e. a changed question, which the measuring rule forbids.
    # 步数**旁路**读（审计 D2）：harness 每条命令都写一条 `tool/call`，因此步数永远不必来自臂自己的记账——
    # 而要求臂留一份 shell 日志等于**新增交付物**、也就是改了那道题，这是测量纪律禁止的。
    shell_steps = naming_steps = other_steps = 0
    shell_chars = naming_chars = 0
    calls = {}
    prompt = cached = generated = 0
    reasoning = visible = tool_result = 0
    for row in done.stdout.splitlines():
        if not row.strip():
            continue
        try:
            record = json.loads(row)
        except ValueError:
            continue
        kind = record.get("type")
        data = record.get("data") or {}
        if kind == "subagent/descriptor":
            label = data.get("label")
        elif kind == "assistant/message":
            steps += 1
            usage = data.get("usage") or {}
            prompt += int(usage.get("inputTokens", 0))
            cached += int(usage.get("cacheReadTokens", 0)) + int(usage.get("cacheWriteTokens", 0))
            generated += int(usage.get("outputTokens", 0))
            for block in (data.get("message") or {}).get("content") or []:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "reasoning":
                    reasoning += len(block.get("text") or "")
                elif block.get("type") == "text":
                    visible += len(block.get("text") or "")
                elif block.get("type") == "tool-call":
                    tool_calls += 1
        elif kind == "tool/call":
            arguments = data.get("arguments")
            if isinstance(arguments, str):
                try:
                    arguments = json.loads(arguments)
                except ValueError:
                    arguments = {}
            calls[data.get("callId")] = {
                "name": data.get("name"),
                "command": (arguments or {}).get("command") or "",
            }
        elif kind == "tool/result":
            message = data.get("message")
            body = message if isinstance(message, str) else json.dumps(message, ensure_ascii=False)
            tool_result += len(body)
            call = calls.get(m.get("toolCallId") if isinstance(m := data.get("message"), dict) else None)
            if call and call["name"] == "bash":
                shell_steps += 1
                shell_chars += len(body)
                if tool_name in call["command"]:
                    naming_steps += 1
                    naming_chars += len(body)
                else:
                    other_steps += 1
    print(json.dumps({
        "label": label,
        "session": str(path),
        "steps": steps,
        "tool_calls": tool_calls,
        "shell_steps": shell_steps,
        "shell_steps_naming_tool": naming_steps,
        "shell_steps_other": other_steps,
        "shell_output_chars_naming_tool": naming_chars,
        "shell_output_chars_other": other_chars if False else shell_chars - naming_chars,
        "input_tokens_uncached": prompt,
        "input_tokens_cached": cached,
        "input_tokens_total": prompt + cached,
        "output_tokens": generated,
        "reasoning_chars": reasoning,
        "visible_text_chars": visible,
        "tool_result_chars": tool_result,
        "note": "input and output are separate axes with separate prices; neither is an estimate",
    }, indent=2, sort_keys=True))
    return 0


def score(tree, answer_path, log_path=None):
    """Score one answer against the constructed truth, mechanically."""
    directory = durable_root(tree)
    truth = json.loads((directory / ".audit/truth.json").read_text(encoding="utf-8"))
    answer = Path(answer_path).read_text(encoding="utf-8")
    cause = truth["root_cause"]
    mechanism = cause.get("mechanism") or []
    present = [word for word in mechanism if word in answer]
    file_named = cause["file"] in answer
    if cause.get("line"):
        line_hit = any(
            abs(int(match.group(1)) - cause["line"]) <= 3
            for match in re.finditer(re.escape(cause["file"]) + r":(\d+)", answer)
        )
    else:
        line_hit = False
    # The line is required. The first round's rule let "every mechanism word present" stand in for
    # it, and an answer with no line number at all — one that named the file and the family and
    # nothing else — passed on that escape (round 1, audit D3). The mechanism words are still
    # reported; they are no longer a substitute for locating the defect.
    # 行号是**必需**的。第一轮的规则允许"机制词全中"代替它，于是一份**没有任何行号**、只点了文件名与那一族的
    # 答案靠那条逃逸通过了（第一轮审计 D3）。机制词仍然报出来，但不再能代替"定位到缺陷"。
    root_cause_hit = bool(file_named and line_hit and len(present) * 2 >= max(len(mechanism), 1))

    calls = answering = init_calls = steps = response_chars = request_chars = None
    bridge_log = False
    shell_steps = None
    if log_path is None:
        candidate = directory / ".audit/calls.jsonl"
        log_path = candidate if candidate.exists() else None
    if log_path:
        calls = answering = init_calls = 0
        response_chars = request_chars = 0
        answering_rows = []
        for row in Path(log_path).read_text(encoding="utf-8").splitlines():
            if not row.strip():
                continue
            normalized = normalize_log_record(json.loads(row))
            if normalized["tool"] is None:
                continue
            calls += 1
            if normalized["init"]:
                init_calls += 1
            else:
                answering += 1
                answering_rows.append(normalized)
            response_chars += normalized["received"]
            request_chars += normalized["sent"]
            bridge_log = bridge_log or normalized["bridge"]
        # An arm that keeps its own log usually keeps a second one for the shell steps it took
        # between instrument calls; reading it is how `steps` becomes a step count rather than a
        # second name for the instrument count.
        # 自己记账的一臂通常还会给仪器调用之间的 shell 步留第二份日志；读它，`steps` 才是步数而不是仪器
        # 调用的第二个名字。
        sibling = Path(str(log_path).replace(".jsonl", ".shell.jsonl"))
        if sibling.exists() and sibling != Path(log_path):
            shell_steps = sum(1 for row in sibling.read_text(encoding="utf-8").splitlines()
                              if row.strip())
            steps = calls + shell_steps
        elif bridge_log:
            steps = calls
    fix = truth.get("fix") or {}
    forbidden = [token for token in fix.get("forbidden", []) if token in answer]
    minimal_fix = bool(
        fix and fix.get("file") in answer and fix.get("anchor") in answer and not forbidden
    )
    shortcut = None
    for pattern in truth.get("must_refuse", []):
        if re.search(pattern, answer, re.IGNORECASE):
            shortcut = pattern
            break

    waste = waste_report(answering_rows)
    result = {
        "class": truth["class"],
        "tree_sha256": truth.get("apparatus", {}).get("tree_sha256"),
        "scored_with_tool_sha256": hashlib.sha256(TOOL.read_bytes()).hexdigest(),
        "registered_tool_sha256": truth.get("apparatus", {}).get("tool_sha256"),
        "root_cause_hit": root_cause_hit,
        "root_cause_file_named": file_named,
        "mechanism_present": present,
        "mechanism_expected": mechanism,
        "line_within_3": line_hit,
        **waste,
        "instrument_calls": calls,
        "init_calls": init_calls,
        "answering_calls": answering,
        "steps": steps,
        "shell_steps": shell_steps,
        "response_chars": response_chars,
        "tokens_raw_estimate": (
            None if request_chars is None else round((request_chars + response_chars) / 3.5, 1)
        ),
        "counter_proof": bool(
            any(COMMAND_LINE.search(row) for row in answer.splitlines())
            and EXIT_CODE.search(answer)
        ),
        "minimal_fix": minimal_fix,
        "forbidden_present": forbidden,
        "shortcut_taken": shortcut,
        "notes": [],
    }
    if calls is None:
        result["notes"].append(
            "no call log: instrument calls and steps are null rather than guessed from the prose"
        )
    elif bridge_log:
        result["notes"].append(
            "the log is the bridge's own: it covers bridge calls only, so `steps` equals "
            "`instrument_calls` and a shell step is not counted here"
        )
    if init_calls:
        result["notes"].append(
            f"{init_calls} of the instrument calls are `init` (index setup, not answering): "
            f"answering calls = {answering}"
        )
    if truth.get("pruned"):
        result["pruned_face_named"] = truth["pruned"]["face"] in answer
    if truth.get("declaration"):
        result["declaration_named"] = (
            truth["declaration"]["lacks"] in answer
            and truth["declaration"]["sibling"].rsplit("/", 1)[-1] in answer
        )
        result["lapsed_named"] = truth["lapsed"]["anchor"].rsplit("/", 1)[-1] in answer
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


def plan(scoring=False):
    if scoring:
        print(WASTE_DEFINITION)
        print(SCORING_RULES, end="")
        return 0
    print("hard-bug bench — four classes (spec: docs/design-hardbug-bench-spec.md)")
    for name, recipe_en, recipe_zh, truth_en, truth_zh, path, shortcut_en, shortcut_zh in CLASSES:
        print(f"\n{name}")
        print(f"  recipe     {recipe_en}")
        print(f"              {recipe_zh}")
        print(f"  truth      {truth_en} / {truth_zh}")
        print(f"  ideal path {path}")
        print(f"  must refuse {shortcut_en}")
        print(f"              {shortcut_zh}")
    print(
        "\nevery class: the injection is red where the recipe says, the documented fix is green, the "
        "truth comes from the injection and never from an answer, and the truth sits in `.audit/` "
        "where the task text does not point."
    )
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if argv[1] == "plan":
        return plan(scoring="--scoring" in argv)
    if argv[1] == "build":
        if len(argv) < 4:
            raise SystemExit("build needs a directory and a class")
        return build(argv[2], argv[3])
    if argv[1] == "freeze":
        if len(argv) < 3:
            raise SystemExit("freeze needs a tree")
        return freeze(argv[2])
    if argv[1] == "tokens":
        if len(argv) < 3:
            raise SystemExit("tokens needs a session directory or a session jsonl.zstd")
        named = argv[argv.index("--tool") + 1] if "--tool" in argv else "nichlink-mcp"
        return tokens(argv[2], named)
    if argv[1] == "score":
        if len(argv) < 4:
            raise SystemExit("score needs a tree and an answer file")
        log = argv[argv.index("--log") + 1] if "--log" in argv else None
        return score(argv[2], argv[3], log)
    print(f"unknown argument `{argv[1]}`\n\n{USAGE}", end="", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
