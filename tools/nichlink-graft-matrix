#!/bin/sh
# The graft × crate matrix: three shapes that only a real host with a real cargo can answer, each of
# which was hand-measured before it was written down here.
# graft × crate 位置矩阵：三种只有"真宿主 + 真 cargo"能回答的形状，每一种都是先手工量过才写进这里。
#
#   1. a cut on the **root face** with `full` — the whole tree replaced from the top;
#   2. **overlapping** cuts (one inside another) — must be refused **by name**, not silently applied;
#   3. a **re-partition** of the host (the subtree holding both cuts handed to a new crate) — the plan
#      must not change and every crate must still build.
#   1. 切口落在**根面**上并带 `full`——整棵树从顶被替换；
#   2. **重叠**的两条切口（一条在另一条里面）——必须**点名拒绝**，不许静默生效；
#   3. 把宿主**重新划分**（装着两条切口的那棵子树交给新 crate）——计划不得改变，各 crate 仍要能构建。
#
# Usage: tools/nichlink-graft-matrix        (NICHLINK_GRAFT_MATRIX_CARGO_FLAGS to override)
# 用法：tools/nichlink-graft-matrix        （用 NICHLINK_GRAFT_MATRIX_CARGO_FLAGS 覆盖 cargo 旗标）
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
WORK=$(mktemp -d "${TMPDIR:-/tmp}/nichlink-graft-matrix.XXXXXX")
CARGO_FLAGS="${NICHLINK_GRAFT_MATRIX_CARGO_FLAGS---offline}"
NICHLINK="$ROOT/target/debug/nichlink"
# Build the binary this script drives, rather than assuming somebody else did: a fresh checkout has no
# `target/debug/nichlink`, and a gate that only passes where it was built by hand fails on the machine
# that matters (measured on CI). Self-contained on purpose — this runs before the helpers below exist.
# 自己构建本脚本要驱动的二进制：全新检出不带它，而在"有人手工构建过"的机器上才通过的闸门，恰好在最要紧的
# 那台机器上失败（CI 实测）。这里刻意不依赖下面的辅助函数——它跑在它们定义之前。
if [ ! -x "$NICHLINK" ]; then
  echo "building the CLI this matrix drives" >&2
  "${CARGO:-cargo}" build ${CARGO_FLAGS-} -p nichlink-toolchain --features cli --bin nichlink >&2 ||
    { echo "cannot build $NICHLINK" >&2; exit 1; }
fi
fail() { printf 'graft matrix FAILED: %s\n' "$1" >&2; exit 1; }
step() { printf '== %s\n' "$1"; }
build() { command cargo build $CARGO_FLAGS "$@"; }

step "building the CLI this matrix drives"
build -p nichlink-toolchain --features cli --bin nichlink >/dev/null 2>&1 ||
  fail "cannot build $NICHLINK"

host() {
  area="$WORK/$1"
  mkdir -p "$area"
  cp -a "$ROOT/examples/partitioned-button/host" "$area/app"
  cp -a "$ROOT/examples/partitioned-button/graft" "$area/ext"
  printf '[workspace]\nresolver = "3"\nmembers = ["app", "ext"]\n' >"$area/Cargo.toml"
  sed -i "s#path = \"../../../toolchain\"#path = \"$ROOT/toolchain\"#g" "$area/app/Cargo.toml" "$area/ext/Cargo.toml"
  sed -i 's#path = "\.\./graft"#path = "../ext"#' "$area/app/Cargo.toml"
  echo "$area"
}

step 'leg 1/3: a cut on the root face with full'
AREA=$(host root-cut)
python3 - "$AREA/app/src/lib.rs" <<'PY'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1]); s = p.read_text()
s = re.sub(
    r"cut\(crate::control::object::button::NODE_ID\)\s*\n\s*graft\(control_button_graft::button_fast::NODE_ID\),",
    "cut(crate::NODE_ID) full\n        graft(control_button_graft::control_fast::NODE_ID),", s, count=1)
s = re.sub(r"\s*cut\(crate::control::object::slider::NODE_ID\)\s*\n\s*graft\(control_button_graft::slider_fast::NODE_ID\),",
           "", s, count=1)
p.write_text(s)
PY
(cd "$AREA/app" && "$NICHLINK" check . >/dev/null 2>&1) || fail "the root-face cut does not check"
[ "$(sed -n '2p' "$AREA/app/target/nichlink/out/graft_plan.tsv" | cut -f1)" = "crate::NODE_ID" ] ||
  fail "the plan does not record the root-face cut"
(cd "$AREA/app" && build >/dev/null 2>&1) || fail "the root-face cut does not build"

step "leg 2/3: overlapping cuts keep the later entry and say which one answers"
AREA=$(host overlap)
python3 - "$AREA/app/src/lib.rs" <<'PY'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1]); s = p.read_text()
s = re.sub(
    r"cut\(crate::control::object::button::NODE_ID\)\s*\n\s*graft\(control_button_graft::button_fast::NODE_ID\),",
    "cut(crate::control::object::button::NODE_ID)\n        graft(control_button_graft::button_fast::NODE_ID),\n    cut(crate::control::NODE_ID) full\n        graft(control_button_graft::control_fast::NODE_ID),", s, count=1)
p.write_text(s)
PY
(cd "$AREA/app" && "$NICHLINK" check . >"$WORK/overlap.out" 2>&1) ||
  fail "overlapping cuts no longer check: $(head -3 "$WORK/overlap.out")"
# The decision is spoken: both entries named, and which one answers.
grep -q "two graft cuts overlap" "$WORK/overlap.out" ||
  fail "the overlap went unmentioned: $(head -3 "$WORK/overlap.out")"
grep -q "later, wins" "$WORK/overlap.out" ||
  fail "the hint does not say which entry answers: $(grep -m1 overlap "$WORK/overlap.out")"
printf '   hint: %s\n' "$(grep -m1 'two graft cuts overlap' "$WORK/overlap.out" | cut -c1-200)"
# And only the winner reaches the plan: the later `control` full entry replaces the earlier button cut.
PLAN="$AREA/app/target/nichlink/out/graft_plan.tsv"
[ -f "$PLAN" ] || fail "no graft plan to read"
# The fixture declares three cuts — `button`, then `control` (full), then `slider`. Pairwise "later
# wins" therefore leaves exactly the **last** one: `slider` supersedes `control`, which superseded
# `button`. Both earlier entries must be gone from the plan, and the last one must be in it.
# 夹具声明了三条切口——`button`、`control`(full)、`slider`。逐对"后者赢"因此只留下**最后**一条：
# `slider` 盖住 `control`，`control` 又盖住 `button`。前两条都必须从计划里消失，最后一条必须在。
grep -q "crate::control::object::slider::NODE_ID" "$PLAN" ||
  fail "the last cut is not in the plan: $(cat "$PLAN" | tr '\n' ' ')"
if grep -q "crate::control::object::button::NODE_ID" "$PLAN"; then
  fail "a superseded cut is still in the plan"
fi
if grep -q "crate::control::NODE_ID" "$PLAN"; then
  fail "the intermediate cut is still in the plan"
fi
(cd "$AREA/app" && build >/dev/null 2>&1) || fail "the overlapping host does not build"

step "leg 3/3: re-partitioning the host keeps the plan and every crate"
AREA=$(host repartition)
cat >"$AREA/app/add_crates.rs" <<'RS'
use nichlink_toolchain::run_method::{Crate, Shape};

pub fn add_crates() -> Shape {
    Shape::of("app", &[Crate::named("objects").at(&[crate::control::SUBTREE])])
}
RS
# The plan to compare against is the one the **declaration** publishes, so it is taken *after* the first
# `check` — not before it. Read before, this line hashed whatever happened to sit in the copied
# `host/target/`: on a machine that had built the example it is the same plan and the comparison passes,
# and on a fresh checkout (CI) the file is absent, so `md5sum` hashed empty input and every run failed
# with "re-partitioning changed the graft plan". Measured — that is exactly how this leg failed on CI
# while passing locally. The existence check below is what keeps a missing plan from comparing two
# empty hashes and reporting success.
# 用来比较的那份计划是**声明**发布出来的，因此在第一次 `check` **之后**取，而不是之前。在它之前读，这一行
# 哈希的是复制过来的 `host/target/` 里恰好躺着的东西：在构建过示例的机器上它就是同一份计划，于是比较通过；
# 而在全新检出（CI）上该文件不存在，`md5sum` 哈希的是空输入，于是每次都报 "re-partitioning changed the
# graft plan"。实测——这正是这条腿在 CI 上红而本地绿的原因。下面的存在性检查正是让"计划缺失"不会变成
# "两个空哈希相等、于是报成功"。
(cd "$AREA/app" && "$NICHLINK" check . >/dev/null 2>&1) || fail "the declared host does not check"
# The witness is the **unpartitioned** build's own table, taken after building it: one crate compiles every face,
# so its table is the whole declared plan. It has to be built rather than only checked, because `check` writes
# the CLI's records (`target/nichlink/out`) and a build script writes the package's own (`build/*/out`) — and the
# second is what a package actually emits.
# 证人是**未分区**那次构建自己的表，在构建之后取：一个 crate 编译每一个面，因此它的表就是整份声明的计划。它必须
# 被**构建**而不只是 check，因为 `check` 写的是 CLI 的记录（`target/nichlink/out`），而包的构建脚本写自己的那份
# （`build/*/out`）——后者才是这个包真正发射的东西。
(cd "$AREA/app" && build >/dev/null 2>&1) || fail "the declared host does not build"
before=$(find "$AREA/target" -path '*/build/*/out/graft_plan.tsv' -type f | head -1)
[ -n "$before" ] || fail "the unpartitioned host emitted no graft plan at all"
before=$(md5sum <"$before")
(cd "$AREA/app" && "$NICHLINK" crates --write . >/dev/null 2>&1) || fail "the split is not written"
(cd "$AREA/app" && "$NICHLINK" check . >/dev/null 2>&1) || fail "the split host does not check"
# The partition root is the **workspace** root, so the generated packages sit beside the host, and the
# remap config it wrote is found by running cargo from there.
# 划分根是**工作区**根：生成包落在宿主旁边，而它写下的 remap 配置要靠"从那里跑 cargo"才会被找到。
[ -d "$AREA/crates/app-objects" ] || fail "the split did not produce the ghost"
[ -d "$AREA/crates/app-facade" ] || fail "the split did not produce the facade"
(cd "$AREA" && build --workspace >/dev/null 2>&1) || fail "a crate of the split does not build"
# After the split the host legitimately emits **fewer** cuts (it no longer compiles the faces that moved), so the
# package to compare is the **facade**: it carries the union, which is the unpartitioned plan. Comparing the
# host's own table here would either fail (correctly — attribution changed) or pass for the wrong reason, which
# is what it used to do while every package carried the host's whole plan (audit `M7`, §M7.55).
# 划分之后宿主合法地**少发**几条（它不再编译搬走的那些面），因此要比的包是 **facade**：它携带并集，也就是未分区
# 的那份计划。在这里比宿主自己的表，要么失败（正确地——归属变了），要么因为一个错理由通过——而那正是它过去所做的
# 事，当时每个包都带着宿主的整份计划（审计 `M7`，§M7.55）。
FACADE_PLAN=$(find "$AREA" -path '*app-facade*/out/graft_plan.tsv' -type f | head -1)
[ -n "$FACADE_PLAN" ] || fail "the split published no facade graft plan"
after=$(md5sum <"$FACADE_PLAN")
[ "$before" = "$after" ] || fail "re-partitioning changed the cuts the tree declares (the facade's union moved)"
cuts=$(find "$AREA/target" "$AREA/crates" -path "*app-objects-*/out/generated_lib.rs" 2>/dev/null | head -1)
[ -n "$cuts" ] || fail "no generated tree for the ghost"
[ "$(grep -c 'StaticGraftCut::from_ids' "$cuts")" = "2" ] ||
  fail "the ghost does not emit both cuts"

printf '\nOK — root-face cut builds, overlapping cuts keep the later entry with a hint, and a re-partitioned host keeps its plan\n'
rm -rf "$WORK"
