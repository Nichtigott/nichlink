#!/bin/sh
# Visual check for Studio: run the real binary in a fixed-size tmux pane, drive it
# with keys, and save what the terminal actually shows.
# Studio 的视觉检查：在固定尺寸的 tmux 面板里运行真实二进制，用按键驱动它，并把终端
# 实际显示的内容存下来。
#
#   tools/nichlink-visual                 # every scene
#   tools/nichlink-visual tree add-form   # named scenes only
#   tools/nichlink-visual --list
#   tools/nichlink-visual --help
#   NICHLINK_VISUAL_X=240 NICHLINK_VISUAL_Y=60 tools/nichlink-visual graph
#   NICHLINK_VISUAL_STDOUT=1 tools/nichlink-visual tree
#
# A name `--list` does not print is an error: it exits 2 and writes nothing, rather than
# waiting for a screen that only a registered name describes.
# `--list` 没有打印的名字是错误：它以 2 退出且什么都不写，而不是去等待一个只有已登记名字才描述得
# 出的屏幕。
#
# Each scene writes two files into `target/visual` (override with
# `NICHLINK_VISUAL_DIR`): `<scene>.txt` is the pane as plain text — the layout,
# which is what a diff should watch — and `<scene>.ansi.txt` keeps whatever SGR
# attributes tmux stored. Measured caveat: tmux stores 24-bit RGB only when its
# own `default-terminal` supports it, so on a plain `screen` server the colour
# escapes are missing and only bold survives. Colour is therefore checked on a
# real terminal; these files are for shape and regression. The default directory
# is build output, so a run leaves nothing in the checkout.
# 每个场景在 `target/visual`（可用 `NICHLINK_VISUAL_DIR` 覆盖）写两个文件：`<scene>.txt`
# 是面板的纯文本——布局，也正是 diff 应当盯的东西；`<scene>.ansi.txt` 保留 tmux 存下的
# SGR 属性。实测的注意点：只有 tmux 自己的 `default-terminal` 支持 24 位色时它才会存下
# RGB，因此在朴素的 `screen` 服务端上颜色转义会缺失、只剩粗体。颜色请在真实终端里看；这些
# 文件用于形状与回归。默认目录属于构建输出，因此一次运行不会往检出里写东西。
#
# Why tmux: ratatui renders through a real terminal, so the honest visual check
# runs the real binary in a real pty at a fixed size instead of trusting a test
# backend. tmux is the pty, the keyboard, and the camera.
# 为什么用 tmux：ratatui 是经真实终端渲染的，因此诚实的视觉检查是在固定尺寸的真实 pty 里跑
# 真实二进制，而不是相信测试后端。tmux 同时充当 pty、键盘和相机。

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
FIXTURE="$ROOT/studio/tests/fixtures/node-editor"
NAMESPACE="nichlink.fixture.node-editor"
QUERY="${NICHLINK_VISUAL_QUERY:-preview_canvas_width}"
TREE_DEMO_QUERY="paint_node_editor"
SESSION="nichlink-visual"
BIN="$ROOT/target/debug/nichlink-studio"
OUT_DIR="${NICHLINK_VISUAL_DIR:-$ROOT/target/visual}"
COLUMNS="${NICHLINK_VISUAL_X:-300}"
ROWS="${NICHLINK_VISUAL_Y:-60}"

# Scenes: name, the marker that proves the screen we asked for is up, the keys.
# 场景：名字、证明"我们要的屏幕已经出来"的标记、按键。
scene_marker() {
    case "$1" in
        home) echo "FACE INSPECTOR" ;;
        search) echo "/ $QUERY" ;;
        graph) echo "CALL TREE" ;;
        tree-demo) echo "CALL TREE" ;;
        partition) echo "CRATE PARTITION" ;;
        tree-steps) echo "CALL TREE" ;;
        tree) echo "CALL TREE" ;;
        data) echo "DATA FLOW" ;;
        add-form) echo "ADD REGISTRATION FACE" ;;
        # Unreachable: `run_scene` refuses a name `scenes()` does not list. If it ever were
        # reached, this marker cannot appear on screen, so the wait fails loudly after its
        # timeout instead of accepting the banner.
        # 不可达：`run_scene` 会拒绝不在 `scenes()` 里的名字。万一真被走到，这个标记不可能出现在
        # 屏幕上，因此那次等待会在超时后明确失败，而不是接受启动横幅。
        *) echo "__UNREGISTERED_SCENE__" ;;
    esac
}

# The project a scene opens, when it is not the shared fixture.
# 场景打开的项目，当它不是共用夹具时。
#
# One scene needs a host that **declares a crate split** (`add_crates.rs`), and the shared fixture —
# a real example host — must not grow one: that file changes what the example builds. So the scene
# brings its own tiny host, written under the build-output directory like every other artifact here.
# 有一个场景需要一个**声明了 crate 拆分**（`add_crates.rs`）的宿主，而共用夹具是一个真实示例宿主、不能加
# 这个文件：它会改变示例构建出来的东西。因此该场景自带一个很小的宿主，与其他产物一样写在构建输出目录下。
scene_fixture() {
    case "$1" in
        partition) echo "$OUT_DIR/partition-host" ;;
        *) echo "" ;;
    esac
}

scene_namespace() {
    case "$1" in
        partition) echo "partition.demo" ;;
        *) echo "$NAMESPACE" ;;
    esac
}

# Write the scene's own host, before the app is started on it.
# 在程序打开它之前，写下该场景自己的宿主。
prepare_scene() {
    case "$1" in
        partition)
            host=$(scene_fixture "$1")
            mkdir -p "$host/src/panel/frame" "$host/target/nichlink/out"
            # Its own `[workspace]`, like every project `nichlink new` writes: without one, a package
            # nested under this checkout would be claimed by the checkout's workspace and cargo could
            # not name it — and the package name is the identity namespace.
            # 自带 `[workspace]`，与 `nichlink new` 写的每个项目一样：没有它，嵌套在本检出之下的包会被本检出的
            # 工作区认领，cargo 就说不出它的名字——而包名就是身份命名空间。
            cat >"$host/Cargo.toml" <<'EOF'
[workspace]

[package]
name = "partition-demo"
version = "0.1.0"
edition = "2024"
EOF
            cat >"$host/src/lib.rs" <<'EOF'
// A demo host for the partition screen: its declaration is the whole point of the scene.
EOF
            cat >"$host/src/panel/panel.rs" <<'EOF'
crate::root_object! { kind: Panel, parent: crate::ROOT_NODE_ID, }
EOF
            cat >"$host/src/panel/frame/frame.rs" <<'EOF'
crate::panel_object! { kind: Frame, parent: crate::panel::NODE_ID, }
EOF
            cat >"$host/add_crates.rs" <<'EOF'
use nichlink_toolchain::runtime::{Crate, Shape};

pub const SHAPE: Shape = Shape {
    package_prefix: "partition-demo",
    crates: &[Crate::named("widgets").at(&[crate::panel::frame::SUBTREE])],
};
EOF
            cat >"$host/target/nichlink/out/pruning_manifest.tsv" <<'EOF'
# node	source	symbol	path	kind	registry_name	parent	source_hash	fields	calls	parent_node	owns_registry	logical_path
00000000000000000000000000000001	panel/panel.rs	Panel	-	Panel	Panel	-	-	-	-	-	false	-
00000000000000000000000000000002	panel/frame/frame.rs	Frame	-	Frame	Frame	-	-	-	-	-	false	-
EOF
            ;;
    esac
}

scene_query() {
    case "$1" in
        home | add-form | partition) echo "" ;;
        tree-demo | tree-steps) echo "$TREE_DEMO_QUERY" ;;
        *) echo "$QUERY" ;;
    esac
}

scene_keys() {
    case "$1" in
        home | search) echo "" ;;
        graph) echo "Enter" ;;
        tree-demo) echo "Enter" ;;
        partition) echo "c" ;;
        tree-steps) echo "Enter Down Down Right" ;;
        tree) echo "Enter Tab" ;;
        data) echo "Enter Tab Tab" ;;
        add-form) echo "a" ;;
    esac
}

scenes() {
    echo "home search add-form graph tree-demo tree-steps tree data partition"
}

# Whether a scene name is one of the registered ones.
# 场景名是否在已登记的那几个里。
#
# The marker lookup falls back for an unknown name, and that fallback used to be the startup
# banner `NICH LINK` — which every scene shows. A typo therefore satisfied its own "expected
# screen" wait without a single keypress and wrote a non-empty file that CI's `test -s`
# accepted, so an unregistered scene name reported success (audit `RC6`). The name is checked
# here instead, and the fallback below can no longer match anything.
# 标记查询对未知名字有回退，而那个回退过去是启动横幅 `NICH LINK`——每个场景都会显示它。于是打错
# 的名字不用按任何键就满足了自己那次"期望屏幕"的等待，还写出一个 CI 的 `test -s` 会接受的非空
# 文件：未登记的场景名因此报成功（审计 `RC6`）。现在改为在这里检查名字，下面的回退也就不再可能
# 匹配到任何东西。
known_scene() {
    for known in $(scenes); do
        [ "$known" = "$1" ] && return 0
    done
    return 1
}

# The header block itself, with no line numbers in it: the range used to be
# hardcoded (`sed -n '2,26p'`), which cut the sentence about `target/visual` in
# half and dropped the whole "Why tmux" paragraph — and every later edit to the
# header shifted which sentences were lost (audit G-11). The dump stops at the
# first line of code, so the header can grow without touching this function.
# 头部注释块本身，不带行号：过去那个范围是写死的（`sed -n '2,26p'`），它把关于
# `target/visual` 的那句话拦腰截断，并整段丢掉了"Why tmux"（审计 G-11）；此后每次改头部，
# 被丢掉的句子都会换一批。转储在遇到第一行代码时停止，因此头部可以增长而不必碰这个函数。
usage() {
    awk '/^#!/ { next } /^#/ { print; next } /^[[:space:]]*$/ { next } { exit }' "$0" |
        sed 's/^# \{0,1\}//'
    printf '\nAvailable scenes: %s\n' "$(scenes)"
    printf 'Pane size: %sx%s (NICHLINK_VISUAL_X / NICHLINK_VISUAL_Y)\n' "$COLUMNS" "$ROWS"
}

build() {
    printf 'building nichlink-studio\n'
    # `--offline` is the local default because this checkout is developed offline.
    # CI has a network and an empty registry cache on a cold runner, so it passes
    # an empty value here; the expansion uses `-` rather than `:-` precisely so an
    # explicitly empty override survives.
    # `--offline` 是本地的默认值，因为本检出在离线环境下开发。CI 有网络，且冷启动时注册表
    # 缓存为空，因此它在这里传空值；展开用的是 `-` 而不是 `:-`，正是为了让显式传入的空值
    # 得以保留。
    # The bin belongs to `nichlink-toolchain` since the nine-crates-into-three merge: the old
    # `-p nichlink-studio` names a package that no longer exists, so this line could only fail.
    # `required-features` gates the bin on `studio`, which is why the feature is named here.
    # 合并（九 crate → 三）之后这个 bin 属于 `nichlink-toolchain`：旧的 `-p nichlink-studio` 点名的包
    # 已经不存在，因此这一行只可能失败。`required-features` 把该 bin 门控在 `studio` 之后，所以这里点名该特性。
    (cd "$ROOT" && cargo build -p nichlink-toolchain --features studio --bin nichlink-studio \
        ${NICHLINK_VISUAL_CARGO_FLAGS---offline})
}

cleanup() {
    tmux kill-session -t "$SESSION" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Wait until the pane shows the marker, or fail loudly instead of saving the
# wrong screen.
# 等待面板出现标记；否则明确失败，而不是把错误的屏幕存下来。
#
# Two facts a failure has to separate, because they have different fixes: the **session is gone**
# (the command died — usually a startup failure, and its stderr is the answer) and the **screen is
# not there yet** (the app is up and slow). The budget is generous for the second: a cold CI runner
# parses a project and runs `cargo metadata` before Studio draws its first frame, and the first
# measured CI run failed at exactly this wait with a completely empty pane.
# 失败必须分开的两件事，因为修法不同：**会话没了**（命令死了——通常是启动失败，答案在它的 stderr 里）与
# **画面还没到**（程序活着但慢）。预算对第二种情况给得宽：冷的 CI runner 在 Studio 画出第一帧之前要解析
# 工程并跑 `cargo metadata`，而第一次实测的 CI 运行正是在这个等待上失败、面板完全空白。
WAIT_TRIES="${NICHLINK_VISUAL_TRIES:-600}"
wait_for() {
    marker="$1"
    scene="${2:-}"
    tries=0
    while [ "$tries" -lt "$WAIT_TRIES" ]; do
        if tmux capture-pane -p -t "$SESSION" 2>/dev/null | grep -q "$marker"; then
            return 0
        fi
        if ! tmux has-session -t "$SESSION" 2>/dev/null; then
            printf 'the session died before "%s" appeared; its stderr followed:\n' "$marker" >&2
            [ -n "$scene" ] && cat "$OUT_DIR/$scene.stderr" >&2 2>/dev/null
            return 1
        fi
        tries=$((tries + 1))
        sleep 0.2
    done
    printf 'scene did not reach "%s" in %s tries; pane followed:\n' "$marker" "$WAIT_TRIES" >&2
    tmux capture-pane -p -t "$SESSION" 2>/dev/null >&2 || true
    if [ -n "$scene" ]; then
        printf 'and its stderr:\n' >&2
        cat "$OUT_DIR/$scene.stderr" >&2 2>/dev/null || true
    fi
    return 1
}

run_scene() {
    name="$1"
    if ! known_scene "$name"; then
        printf "error: unknown scene '%s'; available scenes: %s\n" "$name" "$(scenes)" >&2
        exit 2
    fi
    query=$(scene_query "$name")
    marker=$(scene_marker "$name")
    mkdir -p "$OUT_DIR"
    prepare_scene "$name"
    # An empty query must leave the variable unset: Studio opens the search
    # overlay for an empty value too, which would hide the screen this scene is
    # about.
    # 空查询必须让该变量不存在：Studio 对空值也会打开搜索浮层，那会挡住本场景要看的屏幕。
    if [ -n "$query" ]; then
        command="NICH_LINK_INITIAL_QUERY='$query' '$BIN'"
    else
        command="'$BIN'"
    fi
    fixture=$(scene_fixture "$name")
    [ -n "$fixture" ] || fixture="$FIXTURE"
    namespace=$(scene_namespace "$name")
    tmux new-session -d -s "$SESSION" -x "$COLUMNS" -y "$ROWS" \
        "cd '$fixture' && NICH_LINK_PACKAGE_ROOT='$fixture' NICH_LINK_NAMESPACE='$namespace' $command 2>'$OUT_DIR/$name.stderr'"
    # Two waits, because a scene has two things to prove: the app came up, and
    # the keys produced the screen this scene is about. Capturing between them
    # would sometimes save the previous screen.
    # 两次等待，因为一个场景要证明两件事：程序起来了，以及按键产生了本场景要看的那一屏。
    # 在两者之间抓屏有时会存下上一屏。
    wait_for "NICH LINK" "$name"
    for key in $(scene_keys "$name"); do
        tmux send-keys -t "$SESSION" "$key"
        sleep 0.4
    done
    wait_for "$marker" "$name"
    tmux capture-pane -p -t "$SESSION" >"$OUT_DIR/$name.txt"
    tmux capture-pane -p -e -t "$SESSION" >"$OUT_DIR/$name.ansi.txt"
    cleanup
    printf '%-9s %s\n' "$name" "$OUT_DIR/$name.txt"
    if [ "${NICHLINK_VISUAL_STDOUT:-}" = "1" ]; then
        cat "$OUT_DIR/$name.txt"
    fi
}

case "${1:-}" in
    --help | -h)
        usage
        exit 0
        ;;
    --list)
        scenes
        exit 0
        ;;
    --no-build)
        shift
        ;;
    *)
        build
        ;;
esac

if [ "$#" -eq 0 ]; then
    for name in $(scenes); do
        run_scene "$name"
    done
else
    for name in "$@"; do
        run_scene "$name"
    done
fi
